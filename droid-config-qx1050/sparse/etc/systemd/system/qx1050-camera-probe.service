[Unit]
# NOT enabled by default: the first boot with it enabled (2026-10-24 04:20) ended in
# Qualcomm download mode (USB 05c6:900e), i.e. a hard crash + watchdog. Suspect: binding the
# sensor while CAMSS is still probing. Run by hand (systemctl start) until that is understood.
Description=Retry the front camera sensor probe (CAMSS needs every sensor bound)
After=systemd-udev-settle.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/droid/qx1050-camera-probe.sh
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
