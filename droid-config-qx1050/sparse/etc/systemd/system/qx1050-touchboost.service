[Unit]
# Lists scroll at 30 fps when every frame meets cores waking from power collapse; this keeps the
# CPUs out of deep idle (PM QoS) and the little cluster at full clock while the user touches the
# screen or types, and for 2 s after. Measured 2026-11-23: median frame interval 33 -> 17 ms,
# late frames 80 % -> 31 %. Idle power is unchanged: nothing is held without input.
Description=Touch boost: CPU latency and clock while the user touches or types
After=systemd-udev-settle.service

[Service]
Environment=TOUCHBOOST_LATENCY_US=100
Environment=TOUCHBOOST_HOLD_S=2.0
Environment=TOUCHBOOST_FLOORS=policy0:1804800
ExecStart=/usr/bin/python3 /usr/bin/droid/qx1050-touchboost.py
Restart=on-failure
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
