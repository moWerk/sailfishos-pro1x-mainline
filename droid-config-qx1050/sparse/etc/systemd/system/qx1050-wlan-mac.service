[Unit]
Description=Stable Wi-Fi MAC for wlan0 before connman and wpa_supplicant
# ath10k picks a random address at every probe. A udev RUN program races connman's own
# interface handling (the link can go down under connman), so the address is set in a unit
# that connman and wpa_supplicant are ordered after.
After=sys-subsystem-net-devices-wlan0.device
BindsTo=sys-subsystem-net-devices-wlan0.device
Before=connman.service wpa_supplicant.service

[Service]
Type=oneshot
ExecStart=/usr/bin/droid/qx1050-wlan-mac.sh wlan0
RemainAfterExit=yes

[Install]
WantedBy=sys-subsystem-net-devices-wlan0.device
