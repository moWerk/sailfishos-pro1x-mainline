diff --git a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
index 8ccbc0327..b98d0f8d1 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
@@ -224,6 +224,21 @@ kbd-backlight {
 		};
 	};
 
+	/*
+	 * Stand-in codecs for the two real-time proxy back ends: the AFE
+	 * ports carry a call's audio to and from the host, no codec is
+	 * behind them, but a back-end link needs one.
+	 */
+	rt_proxy_codec_rx: rt-proxy-codec-rx {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0>;
+	};
+
+	rt_proxy_codec_tx: rt-proxy-codec-tx {
+		compatible = "linux,spdif-dir";
+		#sound-dai-cells = <0>;
+	};
+
 	battery: battery {
 		compatible = "simple-battery";
 		device-chemistry = "lithium-ion";
@@ -542,6 +557,39 @@ cpu {
 			};
 		};
 
+		/* a call's downlink to the host and uplink from it (Bluetooth headsets) */
+		rt-proxy-rx-dai-link {
+			link-name = "RT Proxy Playback";
+
+			codec {
+				sound-dai = <&rt_proxy_codec_rx>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai RT_PROXY_RX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
+		rt-proxy-tx-dai-link {
+			link-name = "RT Proxy Capture";
+
+			codec {
+				sound-dai = <&rt_proxy_codec_tx>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai RT_PROXY_TX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
 		wcd-capture-dai-link {
 			link-name = "WCD Capture";
 
