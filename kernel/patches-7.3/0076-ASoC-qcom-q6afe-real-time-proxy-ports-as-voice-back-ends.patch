diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index 8c0c79d0b..f5510b5f5 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -85,6 +85,16 @@
 /* USB AFE port */
 #define AFE_PORT_ID_USB_RX                       0x7000
 
+/*
+ * Real-time proxy ports: the DSP side of a host data path. Audio played into
+ * RX by the DSP (for example a call's downlink) is read by the host, audio the
+ * host writes is captured from TX by the DSP (a call's uplink).
+ */
+#define AFE_PORT_ID_RT_PROXY_RX_1		0x2000
+#define AFE_PORT_ID_RT_PROXY_TX_1		0x2001
+#define AFE_PARAM_ID_RT_PROXY_CONFIG		0x00010213
+#define AFE_API_VERSION_RT_PROXY_CONFIG		0x1
+
 #define AFE_API_VERSION_SLIMBUS_CONFIG 0x1
 /* Clock set API version */
 #define AFE_API_VERSION_CLOCK_SET 1
@@ -621,6 +631,19 @@ struct afe_param_id_usb_audio_svc_interval {
 	u32	svc_interval;
 } __packed;
 
+struct afe_param_id_rt_proxy_cfg {
+	u32 rt_proxy_cfg_minor_version;
+	u16 bit_width;
+	u16 interleaved;
+	u16 frame_size;
+	u16 jitter_allowance;
+	u16 low_water_mark;
+	u16 high_water_mark;
+	u32 sample_rate;
+	u16 num_channels;
+	u16 reserved;
+} __packed;
+
 union afe_port_config {
 	struct afe_param_id_hdmi_multi_chan_audio_cfg hdmi_multi_ch;
 	struct afe_param_id_slimbus_cfg           slim_cfg;
@@ -628,6 +651,7 @@ union afe_port_config {
 	struct afe_param_id_tdm_cfg	tdm_cfg;
 	struct afe_param_id_cdc_dma_cfg	dma_cfg;
 	struct afe_param_id_usb_cfg usb_cfg;
+	struct afe_param_id_rt_proxy_cfg rt_proxy_cfg;
 } __packed;
 
 
@@ -947,6 +971,8 @@ static struct afe_port_map port_maps[AFE_PORT_MAX] = {
 	[RX_CODEC_DMA_RX_7] = { AFE_PORT_ID_RX_CODEC_DMA_RX_7,
 				RX_CODEC_DMA_RX_7, 1, 1},
 	[USB_RX] = { AFE_PORT_ID_USB_RX, USB_RX, 1, 1},
+	[RT_PROXY_RX_1] = { AFE_PORT_ID_RT_PROXY_RX_1, RT_PROXY_RX_1, 1, 1},
+	[RT_PROXY_TX_1] = { AFE_PORT_ID_RT_PROXY_TX_1, RT_PROXY_TX_1, 0, 1},
 	[LPI_MI2S_RX_0] = { AFE_PORT_ID_INT0_MI2S_RX,
 				LPI_MI2S_RX_0, 1, 1},
 	[LPI_MI2S_TX_0] = { AFE_PORT_ID_INT0_MI2S_TX,
@@ -1708,6 +1734,31 @@ void q6afe_cdc_dma_port_prepare(struct q6afe_port *port,
 		dma_cfg->active_channels_mask = (1 << cfg->num_channels) - 1;
 }
 EXPORT_SYMBOL_GPL(q6afe_cdc_dma_port_prepare);
+
+/**
+ * q6afe_rt_proxy_port_prepare() - Prepare a real-time proxy port
+ *
+ * @port: Instance of the port
+ * @cfg: Rate, channels and frame (period) size in bytes
+ *
+ * 16-bit interleaved, the jitter allowance half a frame, no watermark events,
+ * as the downstream audio driver configures it.
+ */
+void q6afe_rt_proxy_port_prepare(struct q6afe_port *port,
+				 struct q6afe_rt_proxy_cfg *cfg)
+{
+	struct afe_param_id_rt_proxy_cfg *pcfg = &port->port_cfg.rt_proxy_cfg;
+
+	memset(pcfg, 0, sizeof(*pcfg));
+	pcfg->rt_proxy_cfg_minor_version = AFE_API_VERSION_RT_PROXY_CONFIG;
+	pcfg->bit_width = 16;
+	pcfg->interleaved = 1;
+	pcfg->frame_size = cfg->frame_size;
+	pcfg->jitter_allowance = cfg->frame_size / 2;
+	pcfg->sample_rate = cfg->sample_rate;
+	pcfg->num_channels = cfg->num_channels;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_port_prepare);
 /**
  * q6afe_port_start() - Start a afe port
  *
@@ -1861,6 +1912,10 @@ struct q6afe_port *q6afe_port_get_from_id(struct device *dev, int id)
 	case AFE_PORT_ID_USB_RX:
 		cfg_type = AFE_PARAM_ID_USB_AUDIO_CONFIG;
 		break;
+	case AFE_PORT_ID_RT_PROXY_RX_1:
+	case AFE_PORT_ID_RT_PROXY_TX_1:
+		cfg_type = AFE_PARAM_ID_RT_PROXY_CONFIG;
+		break;
 	default:
 		dev_err(dev, "Invalid port id 0x%x\n", port_id);
 		return ERR_PTR(-EINVAL);
