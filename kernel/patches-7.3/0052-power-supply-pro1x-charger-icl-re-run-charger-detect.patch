From 3cb919c4aadd66102c803b6f98b22b5a50a5086d Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Sat, 31 Oct 2026 20:58:53 +0100
Subject: [PATCH] power: supply: pro1x-charger-icl: re-run charger detection
 once on DCP
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Plugged into a host while the phone sleeps, the charger detection can
read a dedicated charger (DCP, then DCP + QC 2.0) and usb-moded keeps
the port in charging mode: the gadget came up only minutes later, at
the next detection. Re-run the detection once a few seconds after the
plug-in when it read DCP or QC, as downstream smb5 does when required;
a wall charger reads the same again.

On the Pro1-X after a sleep: DCP, QC2, re-run, SDP, and USB answered in
10 s instead of 375-814 s.

Disclosure: LLMGD-2 · origin O1 (the model wrote it after downstream smb5; built and tested on the device by the model)
LLMGD: v0.3; assurance=A2; flags=T; origin=O1; origin_headline=O1; scope=kernel; graded-by=model; retrieval=none
---
 drivers/power/supply/pro1x-charger-icl.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/power/supply/pro1x-charger-icl.c b/drivers/power/supply/pro1x-charger-icl.c
index 9417f636d..5879d7bd8 100644
--- a/drivers/power/supply/pro1x-charger-icl.c
+++ b/drivers/power/supply/pro1x-charger-icl.c
@@ -37,6 +37,8 @@
 #define POWER_PATH_STATUS	0x10b
 #define  USE_USBIN		BIT(4)
 #define APSD_RESULT_STATUS	0x308
+#define CMD_APSD		0x341
+#define  APSD_RERUN		BIT(0)
 #define  APSD_DCP		BIT(3)
 #define  APSD_CDP		BIT(2)
 #define  APSD_QC2		BIT(5)
@@ -78,6 +80,8 @@ struct pro1x_chg {
 	unsigned int applied_ma;	/* what this plug-in already got */
 	bool present;
 	bool recovered;
+	unsigned int polls_in;	/* polls since this plug-in */
+	bool apsd_rerun;	/* charger detection re-run once for this plug-in */
 	bool user_disabled;	/* charging switched off through charging_enabled */
 	bool awake;		/* holding the system awake while charging */
 	struct power_supply *psy;	/* "usb": cable state for usb-moded and mce */
@@ -235,6 +239,8 @@ static void pro1x_chg_work(struct work_struct *w)
 		pro1x_usb_update(c, was_present, 0);
 		c->applied_ma = 0;
 		c->recovered = false;
+		c->polls_in = 0;
+		c->apsd_rerun = false;
 		c->last_state = -1;
 		pro1x_chg_set_awake(c, false);
 		goto out;
@@ -249,6 +255,20 @@ static void pro1x_chg_work(struct work_struct *w)
 		dev_info(c->dev, "input in: apsd 0x%02x, typec-snk 0x%02x, limit %u mA\n",
 			 apsd, snk, icl);
 	c->present = true;
+	/*
+	 * Some hub ports present a charger at power-on and only become a data port a
+	 * moment later; detection then reads DCP or QC, usb-moded stays in charging mode
+	 * and the gadget never comes up. Re-run the detection once, a few seconds after
+	 * the plug-in (as downstream smb5 does when required): a wall charger reads the
+	 * same again.
+	 */
+	if (c->polls_in < 2)
+		c->polls_in++;
+	else if (!c->apsd_rerun && (apsd & (APSD_DCP | APSD_QC2 | APSD_QC3))) {
+		c->apsd_rerun = true;
+		regmap_write(c->map, c->base + CMD_APSD, APSD_RERUN);
+		dev_info(c->dev, "detection read 0x%02x, re-running it once\n", apsd);
+	}
 	pro1x_usb_update(c, was_present, apsd);
 	c->last_apsd = apsd;
 	c->last_snk = snk;
-- 
