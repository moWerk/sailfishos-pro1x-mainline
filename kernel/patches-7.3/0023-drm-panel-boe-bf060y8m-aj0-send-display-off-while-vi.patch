From 8031c4ff7423c4f791b01ab70270167adda658e4 Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Thu, 29 Oct 2026 12:53:11 +0100
Subject: [PATCH] drm/panel: boe-bf060y8m-aj0: send display off while video
 still runs

The display off command was sent from unprepare, after the DSI host had
stopped the video stream. The panel then scanned out one corrupted frame
(colour shifted, horizontal lines) at full brightness before going dark,
visible on every display blank as a flash after the fade-out.

Send display off from a new disable callback, while frames still arrive,
and keep only sleep in for unprepare.
---
 .../gpu/drm/panel/panel-boe-bf060y8m-aj0.c    | 25 ++++++++++++++++---
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c b/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
index d7e611c85..28e88c0c0 100644
--- a/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
+++ b/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
@@ -92,16 +92,32 @@ static void boe_bf060y8m_aj0_off(struct boe_bf060y8m_aj0 *boe)
 	struct mipi_dsi_device *dsi = boe->dsi;
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	/* OFF commands sent in HS mode */
+	/* OFF commands sent in HS mode; display off went out in disable */
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 20);
-
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 }
 
+/*
+ * Display off goes out while the host still streams video. Sent from
+ * unprepare, after the stream has stopped, the panel scanned out one
+ * corrupted frame at full brightness before turning off.
+ */
+static int boe_bf060y8m_aj0_disable(struct drm_panel *panel)
+{
+	struct boe_bf060y8m_aj0 *boe = to_boe_bf060y8m_aj0(panel);
+	struct mipi_dsi_device *dsi = boe->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
 static int boe_bf060y8m_aj0_prepare(struct drm_panel *panel)
 {
 	struct boe_bf060y8m_aj0 *boe = to_boe_bf060y8m_aj0(panel);
@@ -207,6 +223,7 @@ static int boe_bf060y8m_aj0_get_modes(struct drm_panel *panel,
 
 static const struct drm_panel_funcs boe_bf060y8m_aj0_panel_funcs = {
 	.prepare = boe_bf060y8m_aj0_prepare,
+	.disable = boe_bf060y8m_aj0_disable,
 	.unprepare = boe_bf060y8m_aj0_unprepare,
 	.get_modes = boe_bf060y8m_aj0_get_modes,
 };
