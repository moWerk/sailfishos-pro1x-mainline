+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+
+	struct regmap *regmap;
+	const struct s5k4h7_mode *cur_mode;
+};
+
+static inline struct s5k4h7 *to_s5k4h7(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k4h7, sd);
+}
+
+static int s5k4h7_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *s = to_s5k4h7(sd);
+	int i, ret;
+
+	/* IO first, then analogue, then digital (matches the vendor sequence) */
+	for (i = 0; i < ARRAY_SIZE(s5k4h7_supply_name); i++) {
+		ret = regulator_enable(s->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				s5k4h7_supply_name[i], ret);
+			goto err_regs;
+		}
+		usleep_range(1000, 2000);
+	}
+
+	ret = clk_prepare_enable(s->xclk);
+	if (ret) {
+		dev_err(dev, "clk prepare enable failed\n");
+		goto err_regs;
+	}
+
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(s->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regs:
+	while (--i >= 0)
+		regulator_disable(s->supplies[i].consumer);
+	return ret;
+}
+
+static int s5k4h7_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *s = to_s5k4h7(sd);
+	int i;
+
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+	clk_disable_unprepare(s->xclk);
+	for (i = ARRAY_SIZE(s5k4h7_supply_name) - 1; i >= 0; i--)
+		regulator_disable(s->supplies[i].consumer);
+
+	return 0;
+}
+
+static int s5k4h7_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = S5K4H7_MBUS_CODE;
+
+	return 0;
+}
+
+static int s5k4h7_enum_frame_size(struct v4l2_subdev *subdev,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != S5K4H7_MBUS_CODE)
+		return -EINVAL;
+
+	if (fse->index >= ARRAY_SIZE(s5k4h7_modes))
+		return -EINVAL;
+
+	fse->min_width = s5k4h7_modes[fse->index].width;
+	fse->max_width = s5k4h7_modes[fse->index].width;
+	fse->min_height = s5k4h7_modes[fse->index].height;
+	fse->max_height = s5k4h7_modes[fse->index].height;
+
+	return 0;
+}
+
+static int s5k4h7_update_cur_mode_controls(struct s5k4h7 *s,
+					   const struct s5k4h7_mode *mode)
+{
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(s->vblank,
+				       mode->vts_def - mode->height,
+				       S5K4H7_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	h_blank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(s->hblank, h_blank, h_blank, 1, h_blank);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->vts_def - S5K4H7_EXP_MARGIN;
+	return __v4l2_ctrl_modify_range(s->exposure, S5K4H7_EXP_MIN,
+					exposure_max, S5K4H7_EXP_STEP,
+					exposure_max);
+}
+
+static void s5k4h7_update_pad_format(const struct s5k4h7_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = S5K4H7_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k4h7_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct s5k4h7 *s = to_s5k4h7(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt;
+	struct v4l2_rect *crop;
+	const struct s5k4h7_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k4h7_modes, ARRAY_SIZE(s5k4h7_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	*crop = mode->crop;
+
+	s5k4h7_update_pad_format(mode, &fmt->format);
+	mbus_fmt = v4l2_subdev_state_get_format(state, 0);
+	*mbus_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	s->cur_mode = mode;
+	s5k4h7_update_cur_mode_controls(s, mode);
+
+	return 0;
+}
+
+static int s5k4h7_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = S5K4H7_NATIVE_WIDTH;
+		sel->r.height = S5K4H7_NATIVE_HEIGHT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int s5k4h7_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = S5K4H7_MBUS_CODE,
+			.width = s5k4h7_modes[0].width,
+			.height = s5k4h7_modes[0].height,
+		},
+	};
+
+	s5k4h7_set_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int s5k4h7_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k4h7 *s = container_of(ctrl->handler, struct s5k4h7, ctrls);
+	struct v4l2_subdev_state *state;
+	const struct v4l2_mbus_framefmt *format;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&s->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exposure_max = format->height + ctrl->val - S5K4H7_EXP_MARGIN;
+
+		__v4l2_ctrl_modify_range(s->exposure, s->exposure->minimum,
+					 exposure_max, s->exposure->step,
+					 exposure_max);
+	}
+
+	/* Controls are only written to the sensor while it is powered. */
+	if (!pm_runtime_get_if_active(s->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s->regmap, S5K4H7_EXP_REG, ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s->regmap, S5K4H7_AGAIN_REG, ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s->regmap, S5K4H7_FRAME_LENGTH_REG,
+				s->cur_mode->height + ctrl->val, NULL);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put(s->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k4h7_ctrl_ops = {
+	.s_ctrl = s5k4h7_set_ctrl,
+};
+
+static int s5k4h7_start_streaming(struct s5k4h7 *s)
+{
+	const struct s5k4h7_reg_list *reg_list = &s->cur_mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(s->regmap, s5k4h7_init_regs,
+				  ARRAY_SIZE(s5k4h7_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(s->regmap, reg_list->regs,
+				  reg_list->num_of_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&s->ctrls);
+	if (ret < 0) {
+		dev_err(s->dev, "could not sync v4l2 controls\n");
+		goto err_rpm_put;
+	}
+
+	ret = cci_write(s->regmap, S5K4H7_STREAMING_REG, 1, NULL);
+	if (ret < 0) {
+		dev_err(s->dev, "write STREAMING_REG failed: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static int s5k4h7_stop_streaming(struct s5k4h7 *s)
+{
+	int ret;
+
+	ret = cci_write(s->regmap, S5K4H7_STREAMING_REG, 0, NULL);
+	if (ret < 0)
+		dev_err(s->dev, "could not send stop streaming %d\n", ret);
+
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static int s5k4h7_s_stream(struct v4l2_subdev *subdev, int enable)
+{
+	struct s5k4h7 *s = to_s5k4h7(subdev);
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	state = v4l2_subdev_lock_and_get_active_state(subdev);
+
+	if (enable)
+		ret = s5k4h7_start_streaming(s);
+	else
+		ret = s5k4h7_stop_streaming(s);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops s5k4h7_video_ops = {
+	.s_stream = s5k4h7_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4h7_subdev_pad_ops = {
+	.enum_mbus_code = s5k4h7_enum_mbus_code,
+	.enum_frame_size = s5k4h7_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k4h7_set_format,
+	.get_selection = s5k4h7_get_selection,
+};
+
+static const struct v4l2_subdev_ops s5k4h7_subdev_ops = {
+	.video = &s5k4h7_video_ops,
+	.pad = &s5k4h7_subdev_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k4h7_internal_ops = {
+	.init_state = s5k4h7_init_state,
+};
+
+static int s5k4h7_parse_fwnode(struct s5k4h7 *s)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long bitmap;
+	struct device *dev = s->dev;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err(dev, "parsing endpoint node failed\n");
+		goto done;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = dev_err_probe(dev, -EINVAL, "only 4 data lanes supported\n");
+		goto free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k4h7_link_freq_menu_items,
+				       ARRAY_SIZE(s5k4h7_link_freq_menu_items),
+				       &bitmap);
+free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+done:
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static int s5k4h7_init_controls(struct s5k4h7 *s)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&s->sd);
+	const struct s5k4h7_mode *mode = &s5k4h7_modes[0];
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *hdl = &s->ctrls;
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 8);
+	if (ret)
+		return ret;
+
+	s->link_freq = v4l2_ctrl_new_int_menu(hdl, &s5k4h7_ctrl_ops,
+					      V4L2_CID_LINK_FREQ,
+					      ARRAY_SIZE(s5k4h7_link_freq_menu_items) - 1,
+					      0, s5k4h7_link_freq_menu_items);
+	if (s->link_freq)
+		s->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s->pixel_rate = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					  V4L2_CID_PIXEL_RATE, S5K4H7_PIXEL_RATE,
+					  S5K4H7_PIXEL_RATE, 1, S5K4H7_PIXEL_RATE);
+
+	s->vblank = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops, V4L2_CID_VBLANK,
+				      mode->vts_def - mode->height,
+				      S5K4H7_VTS_MAX - mode->height, 1,
+				      mode->vts_def - mode->height);
+
+	h_blank = mode->hts - mode->width;
+	s->hblank = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops, V4L2_CID_HBLANK,
+				      h_blank, h_blank, 1, h_blank);
+	if (s->hblank)
+		s->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K4H7_AGAIN_MIN, S5K4H7_AGAIN_MAX, S5K4H7_AGAIN_STEP,
+			  S5K4H7_AGAIN_MIN);
+
+	exposure_max = mode->vts_def - S5K4H7_EXP_MARGIN;
+	s->exposure = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops, V4L2_CID_EXPOSURE,
+					S5K4H7_EXP_MIN, exposure_max,
+					S5K4H7_EXP_STEP, exposure_max);
+
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error_ctrls;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k4h7_ctrl_ops, &props);
+	if (ret)
+		goto error_ctrls;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error_ctrls;
+	}
+
+	s->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error_ctrls:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int s5k4h7_identify_module(struct s5k4h7 *s)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s->regmap, S5K4H7_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s->dev, "failed to read chip id\n");
+		return ret;
+	}
+
+	if (val != S5K4H7_CHIP_ID) {
+		dev_err(s->dev, "chip id mismatch: 0x%x != 0x%llx\n",
+			S5K4H7_CHIP_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+static int s5k4h7_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k4h7 *s;
+	int i, ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->dev = dev;
+
+	ret = s5k4h7_parse_fwnode(s);
+	if (ret)
+		return ret;
+
+	s->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s->regmap))
+		return dev_err_probe(dev, PTR_ERR(s->regmap), "failed to init CCI\n");
+
+	s->xclk = devm_v4l2_sensor_clk_get_legacy(dev, NULL, true,
+						  S5K4H7_DEFAULT_CLK_FREQ);
+	if (IS_ERR(s->xclk))
+		return dev_err_probe(dev, PTR_ERR(s->xclk), "failed to get xclk\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k4h7_supply_name); i++)
+		s->supplies[i].supply = s5k4h7_supply_name[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s5k4h7_supply_name),
+				      s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	s->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s->reset_gpio), "failed to get reset gpio\n");
+
+	v4l2_i2c_subdev_init(&s->sd, client, &s5k4h7_subdev_ops);
+	s->sd.internal_ops = &s5k4h7_internal_ops;
+	s->cur_mode = &s5k4h7_modes[0];
+
+	ret = s5k4h7_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = s5k4h7_identify_module(s);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5k4h7_init_controls(s);
+	if (ret) {
+		dev_err(dev, "failed to init controls: %d\n", ret);
+		goto err_power_off;
+	}
+
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	s->sd.dev = dev;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret < 0) {
+		dev_err(dev, "could not register media entity\n");
+		goto err_ctrl_free;
+	}
+
+	s->sd.state_lock = s->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret < 0) {
+		dev_err(dev, "v4l2 subdev init error: %d\n", ret);
+		goto err_media_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret < 0) {
+		dev_err(dev, "could not register v4l2 device\n");
+		goto err_rpm;
+	}
+
+	dev_info(dev, "Samsung S5K4H7 registered\n");
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	v4l2_subdev_cleanup(&s->sd);
+err_media_cleanup:
+	media_entity_cleanup(&s->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(s->sd.ctrl_handler);
+err_power_off:
+	s5k4h7_power_off(dev);
+
+	return ret;
+}
+
+static void s5k4h7_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *s = to_s5k4h7(sd);
+
+	v4l2_async_unregister_subdev(&s->sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&s->sd.entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k4h7_power_off(s->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id s5k4h7_of_match[] = {
+	{ .compatible = "samsung,s5k4h7" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h7_of_match);
