--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -226,6 +226,16 @@ config VIDEO_IMX296
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx296.
 
+config VIDEO_IMX582
+	tristate "Sony IMX582 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX582
+	  camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx582.
+
 config VIDEO_IMX319
 	tristate "Sony IMX319 sensor support"
 	help
@@ -267,6 +277,7 @@ config VIDEO_IMX355
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx355.
 
+
 config VIDEO_IMX412
 	tristate "Sony IMX412 sensor support"
 	depends on OF
@@ -804,6 +815,16 @@ config VIDEO_S5K3M5
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5k3m5.
 
+config VIDEO_S5K4H7
+	tristate "Samsung S5K4H7 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Samsung S5K4H7
+	  camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k4h7.
+
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
 	help
@@ -925,6 +946,15 @@ config VIDEO_DW9714
 	  capability. This is designed for linear control of
 	  voice coil motors, controlled via I2C serial interface.
 
+config VIDEO_DW9800
+	tristate "DW9800 lens voice coil support"
+	help
+	  This is a driver for the Dongwoon DW9800 camera lens voice coil
+	  driver, a 10 bit DAC controlled over I2C.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called dw9800.
+
 config VIDEO_DW9719
 	tristate "DW9719 lens voice coil support"
 	select V4L2_CCI_I2C
