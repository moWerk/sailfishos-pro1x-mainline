diff --git a/drivers/media/i2c/dw9800.c b/drivers/media/i2c/dw9800.c
new file mode 100644
index 000000000..8504c8c06
--- /dev/null
+++ b/drivers/media/i2c/dw9800.c
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Driver for the Dongwoon DW9800 voice coil motor driver (10-bit DAC).
+ *
+ * Register layout as DW9807 (control, DAC MSB/LSB, status). Written for the
+ * F(x)tec Pro1X rear camera; the power-up register defaults are used as is.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+
+#define DW9800_MAX_FOCUS_POS	1023
+
+/* The lens is moved in steps of this many codes when powering up/down. */
+#define DW9800_CTRL_STEPS	16
+#define DW9800_CTRL_DELAY_US	1000
+
+#define DW9800_CTL_ADDR		0x02	/* bit 0: power down */
+#define DW9800_MSB_ADDR		0x03	/* DAC[9:8] */
+#define DW9800_LSB_ADDR		0x04	/* DAC[7:0] */
+#define DW9800_STATUS_ADDR	0x05	/* bit 0: busy */
+
+#define DW9800_MAX_RETRY	10
+
+/* "vio" powers the camera I2C bus pull-ups, "vdd" the motor driver. */
+static const char *const dw9800_supply_name[] = { "vio", "vdd" };
+
+/*
+ * Lens position the camera starts at and returns to when it is opened.
+ * Roughly 1 m focus for a typical phone module; override on the command line
+ * (dw9800.default_pos=N) or with the focus_absolute control.
+ */
+static unsigned int default_pos = 100;
+module_param(default_pos, uint, 0444);
+MODULE_PARM_DESC(default_pos, "Initial lens position (0-1023)");
+
+struct dw9800 {
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_subdev sd;
+	struct regulator_bulk_data supplies[2];
+	u16 current_val;
+};
+
+static inline struct dw9800 *sd_to_dw9800(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct dw9800, sd);
+}
+
+static int dw9800_read_status(struct i2c_client *client)
+{
+	char reg = DW9800_STATUS_ADDR;
+	char val;
+	int ret;
+
+	ret = i2c_master_send(client, &reg, 1);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_master_recv(client, &val, 1);
+	if (ret < 0)
+		return ret;
+
+	return val;
+}
+
+static int dw9800_set_dac(struct i2c_client *client, u16 data)
+{
+	const char tx[3] = { DW9800_MSB_ADDR, (data >> 8) & 0x03, data & 0xff };
+	int val, ret;
+
+	/* Wait for the previous move to be accepted before writing a new one. */
+	ret = readx_poll_timeout(dw9800_read_status, client, val, val <= 0,
+				 DW9800_CTRL_DELAY_US,
+				 DW9800_MAX_RETRY * DW9800_CTRL_DELAY_US);
+	if (ret || val < 0) {
+		if (ret)
+			dev_warn(&client->dev, "VCM busy, position not written\n");
+		return ret ? -EBUSY : val;
+	}
+
+	ret = i2c_master_send(client, tx, sizeof(tx));
+	if (ret < 0) {
+		dev_err(&client->dev, "I2C write DAC failed: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int dw9800_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct dw9800 *dw = container_of(ctrl->handler, struct dw9800, ctrls);
+	struct i2c_client *client = v4l2_get_subdevdata(&dw->sd);
+	int ret = 0;
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	dw->current_val = ctrl->val;
+
+	/* While powered down the value is written on the next resume. */
+	if (!pm_runtime_get_if_in_use(&client->dev))
+		return 0;
+
+	ret = dw9800_set_dac(client, ctrl->val);
+	pm_runtime_put(&client->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops dw9800_ctrl_ops = {
+	.s_ctrl = dw9800_set_ctrl,
+};
+
+static int dw9800_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	return pm_runtime_resume_and_get(sd->dev);
+}
+
+static int dw9800_close(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	pm_runtime_put(sd->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops dw9800_int_ops = {
+	.open = dw9800_open,
+	.close = dw9800_close,
+};
+
+static const struct v4l2_subdev_core_ops dw9800_core_ops = {
+	.log_status = v4l2_ctrl_subdev_log_status,
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_ops dw9800_ops = {
+	.core = &dw9800_core_ops,
+};
+
+static int dw9800_power_up(struct dw9800 *dw)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&dw->sd);
+	const char tx[2] = { DW9800_CTL_ADDR, 0x00 };
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(dw->supplies), dw->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(5000, 6000);
+
+	/* Leave power-down mode. */
+	ret = i2c_master_send(client, tx, sizeof(tx));
+	if (ret < 0) {
+		dev_err(&client->dev, "no response at I2C address 0x%02x: %d\n",
+			client->addr, ret);
+		regulator_bulk_disable(ARRAY_SIZE(dw->supplies), dw->supplies);
+		return ret;
+	}
+	usleep_range(1000, 2000);
+
+	return 0;
+}
+
+static void dw9800_power_down(struct dw9800 *dw)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&dw->sd);
+	const char tx[2] = { DW9800_CTL_ADDR, 0x01 };
+
+	i2c_master_send(client, tx, sizeof(tx));
+	regulator_bulk_disable(ARRAY_SIZE(dw->supplies), dw->supplies);
+}
+
+/* Move the lens gradually to the stored position after power-up. */
+static int dw9800_runtime_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct dw9800 *dw = sd_to_dw9800(i2c_get_clientdata(client));
+	int ret, val;
+
+	ret = dw9800_power_up(dw);
+	if (ret) {
+		dev_err(dev, "failed to power up: %d\n", ret);
+		return ret;
+	}
+
+	for (val = dw->current_val % DW9800_CTRL_STEPS;
+	     val < dw->current_val + DW9800_CTRL_STEPS - 1;
+	     val += DW9800_CTRL_STEPS) {
+		ret = dw9800_set_dac(client, val);
+		if (ret)
+			dev_err_ratelimited(dev, "resume I2C failure: %d\n", ret);
+		usleep_range(DW9800_CTRL_DELAY_US, DW9800_CTRL_DELAY_US + 10);
+	}
+
+	return 0;
+}
+
+/* Park the lens gently at 0 before cutting power. */
+static int dw9800_runtime_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct dw9800 *dw = sd_to_dw9800(i2c_get_clientdata(client));
+	int ret, val;
+
+	for (val = dw->current_val & ~(DW9800_CTRL_STEPS - 1); val >= 0;
+	     val -= DW9800_CTRL_STEPS) {
+		ret = dw9800_set_dac(client, val);
+		if (ret)
+			dev_err_once(dev, "suspend I2C failure: %d\n", ret);
+		usleep_range(DW9800_CTRL_DELAY_US, DW9800_CTRL_DELAY_US + 10);
+	}
+
+	dw9800_power_down(dw);
+
+	return 0;
+}
+
+static int dw9800_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct v4l2_ctrl_handler *hdl;
+	struct dw9800 *dw;
+	int i, ret;
+
+	dw = devm_kzalloc(dev, sizeof(*dw), GFP_KERNEL);
+	if (!dw)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(dw->supplies); i++)
+		dw->supplies[i].supply = dw9800_supply_name[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(dw->supplies), dw->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	v4l2_i2c_subdev_init(&dw->sd, client, &dw9800_ops);
+	dw->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_HAS_EVENTS;
+	dw->sd.internal_ops = &dw9800_int_ops;
+
+	dw->current_val = min_t(unsigned int, default_pos, DW9800_MAX_FOCUS_POS);
+
+	ret = dw9800_power_up(dw);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power up (wrong I2C address?)\n");
+
+	/* The status register must be readable if a DW98xx answers here. */
+	ret = dw9800_read_status(client);
+	if (ret < 0) {
+		dev_err(dev, "no VCM response: %d\n", ret);
+		ret = -ENODEV;
+		goto err_power;
+	}
+
+	hdl = &dw->ctrls;
+	v4l2_ctrl_handler_init(hdl, 1);
+	v4l2_ctrl_new_std(hdl, &dw9800_ctrl_ops, V4L2_CID_FOCUS_ABSOLUTE, 0,
+			  DW9800_MAX_FOCUS_POS, 1, dw->current_val);
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_ctrl;
+	}
+	dw->sd.ctrl_handler = hdl;
+
+	ret = media_entity_pads_init(&dw->sd.entity, 0, NULL);
+	if (ret < 0)
+		goto err_ctrl;
+
+	dw->sd.entity.function = MEDIA_ENT_F_LENS;
+
+	ret = v4l2_async_register_subdev(&dw->sd);
+	if (ret < 0)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	dev_info(dev, "Dongwoon DW9800 lens driver registered\n");
+
+	return 0;
+
+err_entity:
+	media_entity_cleanup(&dw->sd.entity);
+err_ctrl:
+	v4l2_ctrl_handler_free(hdl);
+err_power:
+	dw9800_power_down(dw);
+
+	return ret;
+}
+
+static void dw9800_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct dw9800 *dw = sd_to_dw9800(sd);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		dw9800_runtime_suspend(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_ctrl_handler_free(&dw->ctrls);
+	media_entity_cleanup(&sd->entity);
+}
+
+static const struct of_device_id dw9800_of_table[] = {
+	{ .compatible = "dongwoon,dw9800" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dw9800_of_table);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(dw9800_pm_ops, dw9800_runtime_suspend,
+				 dw9800_runtime_resume, NULL);
+
+static struct i2c_driver dw9800_i2c_driver = {
+	.driver = {
+		.name = "dw9800",
+		.pm = pm_ptr(&dw9800_pm_ops),
+		.of_match_table = dw9800_of_table,
+	},
+	.probe = dw9800_probe,
+	.remove = dw9800_remove,
+};
+module_i2c_driver(dw9800_i2c_driver);
+
+MODULE_DESCRIPTION("Dongwoon DW9800 VCM driver");
+MODULE_LICENSE("GPL");
