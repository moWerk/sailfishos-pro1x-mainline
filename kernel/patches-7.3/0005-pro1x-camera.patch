From 1039e0b709c822dcfb1f78c01068b527e5028be3 Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Mon, 26 Oct 2026 14:24:14 +0100
Subject: [PATCH 05/16] pro1x-camera

From fxtec-pro1x-nixos device/kernel/patches/pro1x-camera.patch (nyymi609, written
against v7.1), rebased onto v7.3 for the SailfishOS port. The board DTS hunks were
3-way merged with upstream 7.1..7.3 changes to sm6115-fxtec-pro1x.dts.

LLMGD-0 A0
---
 .../boot/dts/qcom/sm6115-fxtec-pro1x.dts      |  233 +++
 arch/arm64/boot/dts/qcom/sm6115.dtsi          |  207 ++
 drivers/media/i2c/Kconfig                     |   30 +
 drivers/media/i2c/Makefile                    |    3 +
 drivers/media/i2c/dw9800.c                    |  336 ++++
 drivers/media/i2c/imx582.c                    | 1669 +++++++++++++++++
 drivers/media/i2c/s5k4h7.c                    |  974 ++++++++++
 drivers/media/platform/qcom/camss/camss.c     |   58 +
 8 files changed, 3510 insertions(+)
 create mode 100644 drivers/media/i2c/dw9800.c
 create mode 100644 drivers/media/i2c/imx582.c
 create mode 100644 drivers/media/i2c/s5k4h7.c

diff --git a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
index 562e837fe..4d15aca54 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
@@ -88,6 +88,34 @@ key-volume-up {
 		};
 	};
 
+	vreg_vph_pwr: regulator-vph-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* IMX582 external rails, switched by the PCA9534 on the keyboard I2C bus */
+	vreg_imx582_avdd18: regulator-imx582-avdd18 {
+		compatible = "regulator-fixed";
+		regulator-name = "imx582_avdd18";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pca9534 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vreg_imx582_avdd28: regulator-imx582-avdd28 {
+		compatible = "regulator-fixed";
+		regulator-name = "imx582_avdd28";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pca9534 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	gpio-leds {
 		compatible = "gpio-leds";
 
@@ -133,6 +161,82 @@ &i2c1 {
 
 	status = "okay";
 
+	pm8008: pmic@8 {
+		compatible = "qcom,pm8008";
+		reg = <0x8>;
+
+		interrupts-extended = <&tlmm 25 IRQ_TYPE_EDGE_RISING>;
+		reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+
+		vdd-l1-l2-supply = <&pm6125_s6a>;
+		vdd-l3-l4-supply = <&vreg_vph_pwr>;
+		vdd-l5-supply = <&vreg_vph_pwr>;
+		vdd-l6-supply = <&vreg_vph_pwr>;
+		vdd-l7-supply = <&vreg_vph_pwr>;
+
+		pinctrl-0 = <&pm8008_int_default>, <&pm8008_reset_n_default>;
+		pinctrl-names = "default";
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8008 0 0 2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		#thermal-sensor-cells = <0>;
+
+		regulators {
+			/* IMX582 DVDD */
+			vreg_l1p: ldo1 {
+				regulator-name = "vreg_l1p";
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			/* S5K4H7 DVDD */
+			vreg_l2p: ldo2 {
+				regulator-name = "vreg_l2p";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1056000>;
+			};
+
+			vreg_l3p: ldo3 {
+				regulator-name = "vreg_l3p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* IMX582 AVDD */
+			vreg_l4p: ldo4 {
+				regulator-name = "vreg_l4p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* IMX582 VCM (autofocus) */
+			vreg_l5p: ldo5 {
+				regulator-name = "vreg_l5p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* S5K4H7 AVDD */
+			vreg_l6p: ldo6 {
+				regulator-name = "vreg_l6p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* camera I/O (1.8 V) */
+			vreg_l7p: ldo7 {
+				regulator-name = "vreg_l7p";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+		};
+	};
+
 	pca9534: gpio@21 {
 		compatible = "nxp,pca9534";
 		reg = <0x21>;
@@ -768,6 +872,34 @@ spk_amp_default: spk-amp-default-state {
 		bias-disable;
 	};
 
+	pm8008_int_default: pm8008-int-default-state {
+		pins = "gpio25";
+		function = "gpio";
+		bias-disable;
+		input-enable;
+	};
+
+	pm8008_reset_n_default: pm8008-reset-n-default-state {
+		pins = "gpio26";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+
+	cam_rear_reset: cam-rear-reset-state {
+		pins = "gpio21";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_front_reset: cam-front-reset-state {
+		pins = "gpio66";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	ts_i2c_gpio: ts-i2c-gpio-state {
 		pins = "gpio6", "gpio7";
 		function = "gpio";
@@ -870,3 +1002,104 @@ dai@1 {
 		reg = <VOICEMMODE1>;
 	};
 };
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	/* rear: Sony IMX582 */
+	/* rear lens: Dongwoon DW9800 voice coil */
+	rear_lens: lens@c {
+		compatible = "dongwoon,dw9800";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_l5p>;
+		vio-supply = <&vreg_l7p>;
+	};
+
+	rear_camera: camera@10 {
+		compatible = "sony,imx582";
+		reg = <0x10>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&mclk0_default &cam_rear_reset>;
+		pinctrl-names = "default";
+
+		avdd18-supply = <&vreg_imx582_avdd18>;
+		avdd28-supply = <&vreg_imx582_avdd28>;
+		vio-supply = <&vreg_l7p>;
+		vana-supply = <&vreg_l4p>;
+		vdig-supply = <&vreg_l1p>;
+		lens-focus = <&rear_lens>;
+
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			rear_camera_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <456800000 286400000>;
+				remote-endpoint = <&camss_csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c1 {
+	/* front: Samsung S5K4H7 */
+	front_camera: camera@2d {
+		compatible = "samsung,s5k4h7";
+		reg = <0x2d>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 66 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&mclk2_default &cam_front_reset>;
+		pinctrl-names = "default";
+
+		vio-supply = <&vreg_l7p>;
+		vana-supply = <&vreg_l6p>;
+		vdig-supply = <&vreg_l2p>;
+
+		orientation = <0>;
+		rotation = <90>;
+
+		port {
+			front_camera_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <367000000>;
+				remote-endpoint = <&camss_csiphy2_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	status = "okay";
+};
+
+&camss_ports {
+	port@0 {
+		reg = <0>;
+
+		camss_csiphy0_ep: endpoint {
+			data-lanes = <0 1 2 3>;
+			remote-endpoint = <&rear_camera_ep>;
+		};
+	};
+
+	port@2 {
+		reg = <2>;
+
+		camss_csiphy2_ep: endpoint {
+			data-lanes = <0 1 2 3>;
+			remote-endpoint = <&front_camera_ep>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6115.dtsi b/arch/arm64/boot/dts/qcom/sm6115.dtsi
index c20a0a38e..69027d551 100644
