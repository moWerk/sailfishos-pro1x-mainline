From 04e273465cf92f18e4118a942a8c5d3ab0bbb8aa Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Sat, 31 Oct 2026 12:20:19 +0100
Subject: [PATCH 41/43] clk: qcom: gcc-sm6115: use retention for the USB GDSC
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With the USB30 GDSC switched off in system suspend, the dwc3 glue
loses its QSCRATCH VBUS override (UTMI_OTG_VBUS_VALID, SW_SESSVLD_SEL),
which it only writes at probe: after resume the gadget is pulled up but
the host never sees it. Several Qualcomm SoCs (sc7180, sm6350, sm6375,
sm8250) keep this domain in retention for the same reason.

Disclosure: LLMGD-0 · origin O1 (the model wrote it from reading the dwc3 glue and other gcc drivers; not yet built)
LLMGD: v0.3; assurance=A0; flags=none; origin=O1; origin_headline=O1; scope=kernel; graded-by=model; retrieval=none
---
 drivers/clk/qcom/gcc-sm6115.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/gcc-sm6115.c b/drivers/clk/qcom/gcc-sm6115.c
index a3c9dbe3a..2d288a776 100644
--- a/drivers/clk/qcom/gcc-sm6115.c
+++ b/drivers/clk/qcom/gcc-sm6115.c
@@ -3210,7 +3210,7 @@ static struct gdsc gcc_usb30_prim_gdsc = {
 	.pd = {
 		.name = "gcc_usb30_prim",
 	},
-	.pwrsts = PWRSTS_OFF_ON,
+	.pwrsts = PWRSTS_RET_ON,
 };
 
 static struct gdsc gcc_vcodec0_gdsc = {
