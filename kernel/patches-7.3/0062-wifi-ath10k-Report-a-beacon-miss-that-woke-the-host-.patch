From 40e12746b9d763d9c15d7eff82d13087947a456d Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Wed, 4 Nov 2026 12:18:46 +0100
Subject: [PATCH 2/2] wifi: ath10k: Report a beacon miss that woke the host
 from WoW
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When the firmware wakes the host from WoW with WOW_REASON_AP_ASSOC_LOST,
ath10k only logs the reason. mac80211 does not monitor the connection
while suspended and learns nothing at resume, so the system suspends
again into the same beacon miss, and the firmware wakes it up again.

Remember the vdev of that wakeup and hand it to mac80211 through
ath10k_mac_handle_beacon_miss() at the end of a successful WoW resume,
so that mac80211 probes the AP and disconnects if it is gone. Hold the
system awake for 3 s for that probe.

On the Pro1-X (SM6115, WCN3950, firmware WLAN.HL.3.2.4-00982), without
it, a 3 h battery window had 38 AP_ASSOC_LOST wakeups in loops every
2-4 s, at about 120 mA. With it, 3 such wakeups in 13 h, 2 handed over
(the third was not, cause unknown; the next wakeup 5 s later was), no
loop. The AP's behaviour
varied between runs, so the loop did not occur in every window without
the change either.

Disclosure: LLMGD-2 · origin O1 (the model wrote it from the ath10k WoW and mac80211 suspend paths; built and tested on the device by the model)
LLMGD: v0.3; assurance=A2; flags=T; origin=O1; origin_headline=O1; scope=kernel; graded-by=model; retrieval=none
---
 drivers/net/wireless/ath/ath10k/core.c |  1 +
 drivers/net/wireless/ath/ath10k/wmi.c  |  2 +-
 drivers/net/wireless/ath/ath10k/wow.c  | 18 +++++++++++++++++-
 drivers/net/wireless/ath/ath10k/wow.h  |  9 +++++++--
 4 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/ath/ath10k/core.c b/drivers/net/wireless/ath/ath10k/core.c
index 7c2939cbd..3e9842b6b 100644
--- a/drivers/net/wireless/ath/ath10k/core.c
+++ b/drivers/net/wireless/ath/ath10k/core.c
@@ -3680,6 +3680,7 @@ struct ath10k *ath10k_core_create(size_t priv_size, struct device *dev,
 	init_completion(&ar->target_suspend);
 	init_completion(&ar->driver_recovery);
 	init_completion(&ar->wow.wakeup_completed);
+	ar->wow.bmiss_vdev_id = -1;
 
 	init_completion(&ar->install_key_done);
 	init_completion(&ar->vdev_setup_done);
diff --git a/drivers/net/wireless/ath/ath10k/wmi.c b/drivers/net/wireless/ath/ath10k/wmi.c
index 131cb7a73..2e760be1b 100644
--- a/drivers/net/wireless/ath/ath10k/wmi.c
+++ b/drivers/net/wireless/ath/ath10k/wmi.c
@@ -4688,7 +4688,7 @@ void ath10k_wmi_event_wow_wakeup_host(struct ath10k *ar, struct sk_buff *skb)
 	ath10k_dbg(ar, ATH10K_DBG_WMI, "wow wakeup host reason %s\n",
 		   wow_reason(ev.wake_reason));
 
-	ath10k_wow_wakeup_event(ar, ev.wake_reason);
+	ath10k_wow_wakeup_event(ar, ev.wake_reason, ev.vdev_id);
 }
 
 void ath10k_wmi_event_dcs_interference(struct ath10k *ar, struct sk_buff *skb)
diff --git a/drivers/net/wireless/ath/ath10k/wow.c b/drivers/net/wireless/ath/ath10k/wow.c
index 492659925..9f83003bf 100644
--- a/drivers/net/wireless/ath/ath10k/wow.c
+++ b/drivers/net/wireless/ath/ath10k/wow.c
@@ -563,7 +563,8 @@ void ath10k_wow_op_set_wakeup(struct ieee80211_hw *hw, bool enabled)
 	mutex_unlock(&ar->conf_mutex);
 }
 
-void ath10k_wow_wakeup_event(struct ath10k *ar, enum wmi_wow_wake_reason reason)
+void ath10k_wow_wakeup_event(struct ath10k *ar, enum wmi_wow_wake_reason reason,
+			     u32 vdev_id)
 {
 	switch (reason) {
 	case WOW_REASON_UNSPECIFIED:
@@ -577,6 +578,13 @@ void ath10k_wow_wakeup_event(struct ath10k *ar, enum wmi_wow_wake_reason reason)
 		 */
 		pm_wakeup_dev_event(ar->dev, ATH10K_WOW_RECONNECT_HOLD_MS, false);
 		break;
+	case WOW_REASON_AP_ASSOC_LOST:
+		/* Handed to mac80211 in ath10k_wow_op_resume(); give its probe
+		 * of the AP the time to run.
+		 */
+		ar->wow.bmiss_vdev_id = vdev_id;
+		pm_wakeup_dev_event(ar->dev, ATH10K_WOW_BMISS_HOLD_MS, false);
+		break;
 	default:
 		pm_wakeup_dev_event(ar->dev, ATH10K_WOW_WAKE_HOLD_MS, false);
 		break;
@@ -610,6 +618,14 @@ int ath10k_wow_op_resume(struct ieee80211_hw *hw)
 	if (ret)
 		ath10k_warn(ar, "failed to cleanup nlo: %d\n", ret);
 
+	/* The firmware does not report the beacon miss itself after WoW, and
+	 * mac80211 does not monitor the connection while suspended: without
+	 * this the host suspends into the same miss again and again.
+	 */
+	if (!ret && ar->wow.bmiss_vdev_id >= 0)
+		ath10k_mac_handle_beacon_miss(ar, ar->wow.bmiss_vdev_id);
+	ar->wow.bmiss_vdev_id = -1;
+
 exit:
 	if (ret) {
 		switch (ar->state) {
diff --git a/drivers/net/wireless/ath/ath10k/wow.h b/drivers/net/wireless/ath/ath10k/wow.h
index a58e4d5c7..36fb4b914 100644
--- a/drivers/net/wireless/ath/ath10k/wow.h
+++ b/drivers/net/wireless/ath/ath10k/wow.h
@@ -9,6 +9,8 @@ struct ath10k_wow {
 	u32 max_num_patterns;
 	struct completion wakeup_completed;
 	struct wiphy_wowlan_support wowlan_support;
+	/* vdev whose beacon miss woke the host, or -1 */
+	int bmiss_vdev_id;
 };
 
 /* How long to keep the system awake after the firmware woke it up. After a
@@ -17,6 +19,7 @@ struct ath10k_wow {
  */
 #define ATH10K_WOW_RECONNECT_HOLD_MS	12000
 #define ATH10K_WOW_WAKE_HOLD_MS		2000
+#define ATH10K_WOW_BMISS_HOLD_MS	3000
 
 #ifdef CONFIG_PM
 
@@ -24,7 +27,8 @@ int ath10k_wow_init(struct ath10k *ar);
 int ath10k_wow_op_suspend(struct ieee80211_hw *hw,
 			  struct cfg80211_wowlan *wowlan);
 int ath10k_wow_op_resume(struct ieee80211_hw *hw);
-void ath10k_wow_wakeup_event(struct ath10k *ar, enum wmi_wow_wake_reason reason);
+void ath10k_wow_wakeup_event(struct ath10k *ar, enum wmi_wow_wake_reason reason,
+			     u32 vdev_id);
 void ath10k_wow_op_set_wakeup(struct ieee80211_hw *hw, bool enabled);
 
 #else
@@ -35,7 +39,8 @@ static inline int ath10k_wow_init(struct ath10k *ar)
 }
 
 static inline void ath10k_wow_wakeup_event(struct ath10k *ar,
-					   enum wmi_wow_wake_reason reason)
+					   enum wmi_wow_wake_reason reason,
+					   u32 vdev_id)
 {
 }
 
