+static int q6afe_rt_svc_cmd(struct q6afe *afe, u32 opcode, const void *payload,
+			    size_t size, u32 rsp_opcode)
+{
+	int pkt_size = APR_HDR_SIZE + size;
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	struct apr_pkt *pkt = p;
+
+	if (!p)
+		return -ENOMEM;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.token = AFE_RT_TOKEN;
+	pkt->hdr.opcode = opcode;
+	memcpy(p + APR_HDR_SIZE, payload, size);
+
+	return afe_apr_send_pkt(afe, pkt, NULL, rsp_opcode);
+}
+
+static int q6afe_rt_index(int port_index)
+{
+	if (port_index != RT_PROXY_RX_1 && port_index != RT_PROXY_TX_1)
+		return -EINVAL;
+	return port_index - RT_PROXY_RX_1;
+}
+
+/**
+ * q6afe_rt_proxy_register() - Take a real-time proxy port for host data
+ *
+ * @dev: a child device of the AFE service
+ * @port_index: RT_PROXY_RX_1 (the host reads) or RT_PROXY_TX_1 (it writes)
+ * @cb: called for every read/write acknowledgement and port event, in atomic
+ *	context
+ * @priv: passed to @cb
+ *
+ * Return: 0, or a negative error (the DSP refused, or a timeout).
+ */
+int q6afe_rt_proxy_register(struct device *dev, int port_index,
+			    q6afe_rt_proxy_cb cb, void *priv)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct afe_rt_port_driver_cmd cmd = {};
+	int i = q6afe_rt_index(port_index);
+	int ret;
+
+	if (i < 0)
+		return i;
+
+	afe->rt_priv[i] = priv;
+	WRITE_ONCE(afe->rt_cb[i], cb);
+
+	cmd.port_id = q6afe_get_port_id(port_index);
+	ret = q6afe_rt_svc_cmd(afe, AFE_SERVICE_CMD_REGISTER_RT_PORT_DRIVER,
+			       &cmd, sizeof(cmd),
+			       AFE_SERVICE_CMD_REGISTER_RT_PORT_DRIVER);
+	if (ret)
+		WRITE_ONCE(afe->rt_cb[i], NULL);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_register);
+
+/**
+ * q6afe_rt_proxy_unregister() - Release a real-time proxy port
+ *
+ * @dev: a child device of the AFE service
+ * @port_index: RT_PROXY_RX_1 or RT_PROXY_TX_1
+ */
+void q6afe_rt_proxy_unregister(struct device *dev, int port_index)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct afe_rt_port_driver_cmd cmd = {};
+	int i = q6afe_rt_index(port_index);
+
+	if (i < 0)
+		return;
+
+	cmd.port_id = q6afe_get_port_id(port_index);
+	q6afe_rt_svc_cmd(afe, AFE_SERVICE_CMD_UNREGISTER_RT_PORT_DRIVER,
+			 &cmd, sizeof(cmd),
+			 AFE_SERVICE_CMD_UNREGISTER_RT_PORT_DRIVER);
+	WRITE_ONCE(afe->rt_cb[i], NULL);
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_unregister);
+
+/**
+ * q6afe_memory_map() - Map a buffer for the AFE service
+ *
+ * @dev: a child device of the AFE service
+ * @addr: address as the DSP sees it (with the SMMU stream id in bits 32 up)
+ * @size: size in bytes, rounded up to 4 KiB for the DSP
+ * @handle: the DSP's handle for the mapping
+ *
+ * Return: 0, or a negative error.
+ */
+int q6afe_memory_map(struct device *dev, u64 addr, size_t size, u32 *handle)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct afe_shared_mem_map_cmd cmd = {};
+	int ret;
+
+	cmd.mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd.num_regions = 1;
+	cmd.property_flag = 0;
+	cmd.shm_addr_lsw = lower_32_bits(addr);
+	cmd.shm_addr_msw = upper_32_bits(addr);
+	/* the ADSP takes 4 KiB multiples only; the buffer must cover the rounded size */
+	cmd.mem_size_bytes = PAGE_ALIGN(size);
+
+	afe->mem_map_handle = 0;
+	ret = q6afe_rt_svc_cmd(afe, AFE_SERVICE_CMD_SHARED_MEM_MAP_REGIONS,
+			       &cmd, sizeof(cmd),
+			       AFE_SERVICE_CMDRSP_SHARED_MEM_MAP_REGIONS);
+	if (ret)
+		return ret;
+	if (!afe->mem_map_handle)
+		return -EIO;
+
+	*handle = afe->mem_map_handle;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6afe_memory_map);
+
+/**
+ * q6afe_memory_unmap() - Unmap a buffer mapped with q6afe_memory_map()
+ *
+ * @dev: a child device of the AFE service
+ * @handle: the handle q6afe_memory_map() returned
+ */
+void q6afe_memory_unmap(struct device *dev, u32 handle)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+
+	q6afe_rt_svc_cmd(afe, AFE_SERVICE_CMD_SHARED_MEM_UNMAP_REGIONS,
+			 &handle, sizeof(handle),
+			 AFE_SERVICE_CMD_SHARED_MEM_UNMAP_REGIONS);
+}
+EXPORT_SYMBOL_GPL(q6afe_memory_unmap);
+
+/**
+ * q6afe_rt_proxy_data() - Read from RT_PROXY_RX_1 or write to RT_PROXY_TX_1
+ *
+ * @dev: a child device of the AFE service
+ * @port_index: RT_PROXY_RX_1 (read into the buffer) or RT_PROXY_TX_1 (write)
+ * @addr: DSP address of the data within the mapped buffer
+ * @handle: the mapping's handle
+ * @bytes: bytes to read or write
+ *
+ * Does not wait: the acknowledgement goes to the registered callback. Safe in
+ * atomic context.
+ *
+ * Return: 0, or a negative error if the packet was not sent.
+ */
+int q6afe_rt_proxy_data(struct device *dev, int port_index, u64 addr,
+			u32 handle, u32 bytes)
+{
+	struct q6afe *afe = dev_get_drvdata(dev->parent);
+	struct {
+		struct apr_hdr hdr;
+		struct afe_rt_proxy_data_cmd cmd;
+	} __packed pkt = {};
+	int ret;
+
+	if (q6afe_rt_index(port_index) < 0)
+		return -EINVAL;
+
+	pkt.hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					  APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt.hdr.pkt_size = sizeof(pkt);
+	pkt.hdr.token = port_index;
+	pkt.hdr.opcode = port_index == RT_PROXY_RX_1 ?
+			 AFE_PORT_DATA_CMD_RT_PROXY_PORT_READ_V2 :
+			 AFE_PORT_DATA_CMD_RT_PROXY_PORT_WRITE_V2;
+	pkt.cmd.port_id = q6afe_get_port_id(port_index);
+	pkt.cmd.buffer_address_lsw = lower_32_bits(addr);
+	pkt.cmd.buffer_address_msw = upper_32_bits(addr);
+	pkt.cmd.mem_map_handle = handle;
+	pkt.cmd.available_bytes = bytes;
+
+	ret = apr_send_pkt(afe->apr, (struct apr_pkt *)&pkt);
+	return ret < 0 ? ret : 0;
+}
+EXPORT_SYMBOL_GPL(q6afe_rt_proxy_data);
