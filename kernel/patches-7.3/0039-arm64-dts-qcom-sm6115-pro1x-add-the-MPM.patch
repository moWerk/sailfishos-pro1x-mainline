From 57f5107e393e37d648776a6e100268785b54793f Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Fri, 30 Oct 2026 21:01:49 +0100
Subject: [PATCH 39/40] arm64: dts: qcom: sm6115-pro1x: add the MPM
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The RPM master stats show the APSS never voting for XO shutdown: without
an MPM nothing tells the RPM that the application processor sleeps.
MPM node, pin map and cluster-domain parenting as in agatti.dtsi and the
Lenovo TB-J606L port (pin map from the downstream bengal driver); the
tlmm gets the MPM as its wakeup parent (sm6115_mpm_map maps the touch
and keyboard-slide GPIOs).

Disclosure: LLMGD-2 · origin O1 (the model adapted the J606L/agatti nodes; built and running on the device, the author tested the wake sources)
LLMGD: v0.3; assurance=A2; flags=T; origin=O1; origin_headline=O1; scope=kernel; graded-by=model; retrieval=none
---
 .../boot/dts/qcom/sm6115-fxtec-pro1x.dts      | 44 +++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
index 8bebf369b..645b90416 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
@@ -1597,6 +1597,10 @@ apss_master_stats: sram@150 {
 		reg = <0x150 0x50>;
 	};
 
+	apss_mpm: sram@1b8 {
+		reg = <0x1b8 0x48>;
+	};
+
 	mpss_master_stats: sram@1150 {
 		reg = <0x1150 0x50>;
 	};
@@ -1623,3 +1627,43 @@ rpm-master-stats {
 		qcom,master-names = "APSS", "MPSS", "ADSP", "CDSP", "TZ";
 	};
 };
+
+/*
+ * MPM, as on QCM2290 (agatti.dtsi) and in the Lenovo TB-J606L port: it watches the wakeup
+ * interrupts while the GIC is off and, as the parent of both CPU cluster domains, tells the RPM
+ * that the application processor sleeps. Without it the RPM master stats show APSS never
+ * voting for XO shutdown. Pin map: downstream bengal (qcom-mpm-bengal.c), less 32 for the SPI
+ * numbers; the tlmm GPIOs map through the pinctrl driver's sm6115_mpm_map (touch 80 -> 21,
+ * keyboard slide 96 -> 49).
+ */
+&rpm {
+	mpm: interrupt-controller {
+		compatible = "qcom,mpm";
+		qcom,rpm-msg-ram = <&apss_mpm>;
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+		mboxes = <&apcs_glb 1>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#power-domain-cells = <0>;
+		interrupt-parent = <&intc>;
+		qcom,mpm-pin-count = <96>;
+		qcom,mpm-pin-map = <2 190>,	/* TSENS */
+				   <5 296>,	/* LPASS SoundWire */
+				   <12 422>,	/* DWC3 ss_phy_irq */
+				   <24 79>,	/* LPASS LPI */
+				   <86 183>,	/* MPM wake, SPMI (PMIC: power key, RTC) */
+				   <90 260>;	/* QUSB2 PHY DP+DM */
+	};
+};
+
+&cluster_0_pd {
+	power-domains = <&mpm>;
+};
+
+&cluster_1_pd {
+	power-domains = <&mpm>;
+};
+
+&tlmm {
+	wakeup-parent = <&mpm>;
+};
