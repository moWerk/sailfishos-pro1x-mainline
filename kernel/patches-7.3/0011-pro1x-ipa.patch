From 7eac84a5047cdc6849494d06d43a85a7bd608b26 Mon Sep 17 00:00:00 2001
From: moWerk <mo@mowerk.net>
Date: Mon, 26 Oct 2026 14:24:16 +0100
Subject: [PATCH 11/16] pro1x-ipa

From fxtec-pro1x-nixos device/kernel/patches/pro1x-ipa.patch (nyymi609, written
against v7.1), rebased onto v7.3 for the SailfishOS port. The board DTS hunks were
3-way merged with upstream 7.1..7.3 changes to sm6115-fxtec-pro1x.dts.

LLMGD-0 A0
---
 .../boot/dts/qcom/sm6115-fxtec-pro1x.dts      | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
index 4ef175a5d..c6dc4722f 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
@@ -905,6 +905,82 @@ &remoteproc_cdsp {
 	status = "okay";
 };
 
+/*
+ * IPA (the modem's data path). ModemManager needs the network interface it
+ * creates, even for SMS and calls. Register layout, interrupts and SMMU ids from
+ * the stock Bengal DT; the AP loads the GSI firmware through TrustZone.
+ */
+&soc {
+	ipa_modem_tables: modem-tables@c123000 {
+		/* modem tables in IMEM, mapped into the IPA IOMMU domain */
+		reg = <0x0 0x0c123000 0x0 0x2000>;
+	};
+
+	ipa: ipa@5840000 {
+		compatible = "qcom,qcm2290-ipa", "qcom,sc7180-ipa";
+
+		iommus = <&apps_smmu 0x140 0x0>,
+			 <&apps_smmu 0x142 0x0>;
+		reg = <0x0 0x05840000 0x0 0x7000>,
+		      <0x0 0x05847000 0x0 0x2000>,
+		      <0x0 0x05804000 0x0 0x23000>;
+		reg-names = "ipa-reg",
+			    "ipa-shared",
+			    "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 257 IRQ_TYPE_EDGE_RISING>,
+				      <&intc GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa",
+				  "gsi",
+				  "ipa-clock-query",
+				  "ipa-setup-ready";
+
+		clocks = <&rpmcc RPM_SMD_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&system_noc MASTER_IPA RPM_ALWAYS_TAG
+				 &bimc SLAVE_EBI_CH0 RPM_ALWAYS_TAG>,
+				<&system_noc MASTER_IPA RPM_ALWAYS_TAG
+				 &system_noc SLAVE_OCIMEM RPM_ALWAYS_TAG>,
+				<&bimc MASTER_AMPSS_M0 RPM_ALWAYS_TAG
+				 &config_noc SLAVE_IPA_CFG RPM_ALWAYS_TAG>;
+		interconnect-names = "memory",
+				     "imem",
+				     "config";
+
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		sram = <&ipa_modem_tables>;
+
+		qcom,gsi-loader = "self";
+		memory-region = <&pil_ipa_fw_mem>;
+		firmware-name = "qcom/sm6115/Fxtec/QX1050/ipa_fws.mbn";
+
+		status = "okay";
+	};
+};
+
+/* "ipa" signalling entries between the AP and the modem */
+/ {
+	smp2p-mpss {
+		ipa_smp2p_out: ipa-ap-to-modem {
+			qcom,entry-name = "ipa";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		ipa_smp2p_in: ipa-modem-to-ap {
+			qcom,entry-name = "ipa";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+};
+
 &remoteproc_mpss {
 	firmware-name = "qcom/sm6115/Fxtec/QX1050/modem.mbn";
 	status = "okay";
-- 
