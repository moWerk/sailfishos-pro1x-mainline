 	};
+
+	spk_amp0: speaker-amplifier@59 {
+		compatible = "awinic,aw87339";
+		reg = <0x59>;
+		enable-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&spk_amp_default>;
+		pinctrl-names = "default";
+		sound-name-prefix = "Spk0";
+	};
+
+	spk_amp1: speaker-amplifier@5a {
+		compatible = "awinic,aw87339";
+		reg = <0x5a>;
+		enable-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&spk_amp_default>;
+		pinctrl-names = "default";
+		sound-name-prefix = "Spk1";
+	};
 };
 
 / {
+	wcd9370: audio-codec {
+		compatible = "qcom,wcd9370-codec";
+
+		pinctrl-0 = <&wcd_reset_default>;
+		pinctrl-names = "default";
+
+		reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm6125_l14a>;
+		vdd-rxtx-supply = <&pm6125_l9a>;
+		vdd-px-supply = <&pm6125_l9a>;
+		/* Input rail of the codec's mic-bias generators (scuba/PM6125 downstream: L22A) */
+		vdd-mic-bias-supply = <&pm6125_l22a>;
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+
+		qcom,rx-device = <&wcd937x_rx>;
+		qcom,tx-device = <&wcd937x_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	sound {
+		compatible = "fxtec,pro1x-sndcard";
+		model = "F(x)tec Pro1X";
+
+		audio-routing = "IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC1", "MIC BIAS1",
+				"AMIC2", "MIC BIAS2",
+				"AMIC3", "MIC BIAS3",
+				/*
+				 * Analog mic ADCs on the TX SoundWire lanes. Same lanes as
+				 * the downstream kernel (ADC1 on SWR_MIC0, ADC2 on SWR_MIC4).
+				 */
+				"TX SWR_INPUT0", "ADC1_OUTPUT",
+				"TX SWR_INPUT4", "ADC2_OUTPUT",
+				/*
+				 * The built-in microphones are digital: the stock Android
+				 * config uses DMIC3 for both the handset and the speaker mic.
+				 */
+				"VA DMIC0", "VA MIC BIAS1",
+				"VA DMIC1", "VA MIC BIAS1",
+				"VA DMIC2", "VA MIC BIAS1",
+				"VA DMIC3", "VA MIC BIAS1",
+				/* the speaker amplifiers sit behind the HPH outputs */
+				"Spk0 IN", "HPHL_OUT",
+				"Spk1 IN", "HPHR_OUT";
+
+		aux-devs = <&spk_amp0>, <&spk_amp1>;
+
+		/* "Spk0 OUT Switch" / "Spk1 OUT Switch" mute the speakers */
+		pin-switches = "Spk0 OUT", "Spk1 OUT";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			codec {
+				sound-dai = <&wcd9370 0>, <&swr1 0>, <&rxmacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
+		va-capture-dai-link {
+			link-name = "VA Capture";
+
+			codec {
+				sound-dai = <&vamacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			codec {
+				sound-dai = <&wcd9370 1>, <&swr0 0>, <&txmacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+	};
+
 	ts_i2c: i2c-touchscreen {
 		compatible = "i2c-gpio";
 		sda-gpios = <&tlmm 6 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
@@ -179,6 +327,85 @@ &i2c2 {
 	status = "disabled";
 };
 
+&rxmacro {
+	pinctrl-0 = <&lpass_rx_swr_active>;
+	pinctrl-names = "default";
+};
+
+&lpass_tlmm {
+	/* LPASS DMIC pair 2/3: clock on gpio8, data on gpio9 (downstream: func1) */
+	lpass_dmic23_active: lpass-dmic23-active-state {
+		clk-pins {
+			pins = "gpio8";
+			function = "dmic23_clk";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio9";
+			function = "dmic23_data";
+			drive-strength = <8>;
+			input-enable;
+		};
+	};
+};
+
+&vamacro {
+	pinctrl-0 = <&lpass_dmic23_active>;
+	pinctrl-names = "default";
+
+	qcom,dmic-sample-rate = <2400000>;
+};
+
+&txmacro {
+	pinctrl-0 = <&lpass_tx_swr_active>;
+	pinctrl-names = "default";
+};
+
+&swr0 {
+	wcd937x_tx: codec@0,3 {
+		compatible = "sdw20217010a00";
+		reg = <0 3>;
+
+		/*
+		 * WCD9370 TX Port 1 (ADC1)               <=> SWR0 Port 1
+		 * WCD9370 TX Port 2 (ADC2, 3)            <=> SWR0 Port 1
+		 * WCD9370 TX Port 3 (DMIC0,1,2,3 & MBHC) <=> SWR0 Port 2
+		 * WCD9370 TX Port 4 (DMIC4,5,6,7)        <=> SWR0 Port 3
+		 */
+		qcom,tx-port-mapping = <1 1 2 3>;
+
+		/*
+		 * Channel mapping in slave port channel order: adc1, adc2, adc3,
+		 * dmic0, dmic1, mbhc, dmic2, dmic3, dmic4, dmic5, dmic6, dmic7.
+		 */
+		qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3>;
+	};
+};
+
+&swr1 {
+	wcd937x_rx: codec@0,4 {
+		compatible = "sdw20217010a00";
+		reg = <0 4>;
+
+		/*
+		 * WCD9370 RX Port 1 (HPH_L/R) <=> SWR1 Port 1 (HPH_L/R)
+		 * WCD9370 RX Port 2 (CLSH)    <=> SWR1 Port 2 (CLSH)
+		 * WCD9370 RX Port 3 (COMP_L/R) <=> SWR1 Port 3 (COMP_L/R)
+		 * WCD9370 RX Port 4 (LO)      <=> SWR1 Port 4 (LO)
+		 * WCD9370 RX Port 5 (DSD_L/R) <=> SWR1 Port 5 (DSD)
+		 */
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+
+		/*
+		 * Channel mapping in slave port channel order: hph_l, hph_r,
+		 * clsh, comp_l, comp_r, lo, dsd_r, dsd_l.
+		 */
+		qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
+	};
+};
+
 &mdss {
 	status = "okay";
 };
@@ -518,6 +745,20 @@ ts_rst_n: ts-rst-n-state {
 		bias-pull-up;
 	};
 
+	wcd_reset_default: wcd-reset-default-state {
+		pins = "gpio92";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
+	spk_amp_default: spk-amp-default-state {
+		pins = "gpio85", "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	ts_i2c_gpio: ts-i2c-gpio-state {
 		pins = "gpio6", "gpio7";
 		function = "gpio";
