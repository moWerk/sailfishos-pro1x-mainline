+	select REGMAP_I2C
+	help
+	  Enable support for the Awinic AW87339 class-K speaker amplifier,
+	  using a hardcoded register sequence (no firmware needed).
+
 config SND_SOC_AW8738
 	tristate "Awinic AW8738 Audio Amplifier"
 	select GPIOLIB
