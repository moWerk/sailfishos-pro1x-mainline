diff --git a/sound/soc/codecs/aw87339.c b/sound/soc/codecs/aw87339.c
new file mode 100644
index 000000000..714b35c96
--- /dev/null
+++ b/sound/soc/codecs/aw87339.c
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// aw87339.c -- Awinic AW87339 class-K speaker amplifier
+//
+// Minimal driver for devices (F(x)tec Pro1X) where the amplifier is fed by
+// the headphone outputs of a codec.  The vendor kernel loads its register
+// sequences from firmware blobs; they are tiny and identical for the
+// "music" scene on both amplifiers, so they are hardcoded here.  The first
+// register write powers the amplifier down, the last one enables it.
+//
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <sound/soc.h>
+
+#define AW87339_REG_CHIPID	0x00
+#define AW87339_REG_SYSCTRL	0x01
+#define AW87339_REG_MAX		0x64
+#define AW87339_CHIPID		0x39
+#define AW87339_PWR_DOWN	0x00
+
+struct aw87339 {
+	struct regmap *regmap;
+	struct gpio_desc *enable;
+	struct mutex lock;
+};
+
+static const struct reg_sequence aw87339_music_seq[] = {
+	{ 0x01, 0x06 },
+	{ 0x02, 0xa3 },
+	{ 0x03, 0x06 },
+	{ 0x04, 0x05 },
+	{ 0x05, 0x0c },	/* gain */
+	{ 0x06, 0x07 },
+	{ 0x07, 0x52 },
+	{ 0x08, 0x03 },
+	{ 0x09, 0x08 },
+	{ 0x0a, 0x96 },
+	{ 0x62, 0x01 },
+	{ 0x63, 0x00 },
+	{ 0x64, 0x00 },
+	{ 0x01, 0x0e },	/* enable */
+};
+
+static const struct regmap_config aw87339_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = AW87339_REG_MAX,
+};
+
+static int aw87339_event(struct snd_soc_dapm_widget *w,
+			 struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct aw87339 *aw = snd_soc_component_get_drvdata(component);
+	int ret = 0;
+
+	mutex_lock(&aw->lock);
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		gpiod_set_value_cansleep(aw->enable, 1);
+		usleep_range(2000, 3000);
+		ret = regmap_multi_reg_write(aw->regmap, aw87339_music_seq,
+					     ARRAY_SIZE(aw87339_music_seq));
+		if (ret)
+			dev_err(component->dev, "enable sequence failed: %d\n", ret);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_write(aw->regmap, AW87339_REG_SYSCTRL, AW87339_PWR_DOWN);
+		gpiod_set_value_cansleep(aw->enable, 0);
+		break;
+	}
+	mutex_unlock(&aw->lock);
+
+	return ret;
+}
+
+static const struct snd_soc_dapm_widget aw87339_dapm_widgets[] = {
+	SND_SOC_DAPM_INPUT("IN"),
+	SND_SOC_DAPM_PGA_E("SPK PA", SND_SOC_NOPM, 0, 0, NULL, 0, aw87339_event,
+			   SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_OUTPUT("OUT"),
+};
+
+static const struct snd_soc_dapm_route aw87339_dapm_routes[] = {
+	{ "SPK PA", NULL, "IN" },
+	{ "OUT", NULL, "SPK PA" },
+};
+
+static const struct snd_soc_component_driver aw87339_component = {
+	.dapm_widgets		= aw87339_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(aw87339_dapm_widgets),
+	.dapm_routes		= aw87339_dapm_routes,
+	.num_dapm_routes	= ARRAY_SIZE(aw87339_dapm_routes),
+	.idle_bias_on		= 0,
+	.use_pmdown_time	= 1,
+	.endianness		= 1,
+};
+
+static int aw87339_i2c_probe(struct i2c_client *i2c)
+{
+	struct aw87339 *aw;
+	unsigned int id;
+	int ret;
+
+	aw = devm_kzalloc(&i2c->dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	mutex_init(&aw->lock);
+	i2c_set_clientdata(i2c, aw);
+
+	aw->regmap = devm_regmap_init_i2c(i2c, &aw87339_regmap);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(&i2c->dev, PTR_ERR(aw->regmap),
+				     "regmap init failed\n");
+
+	aw->enable = devm_gpiod_get(&i2c->dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->enable))
+		return dev_err_probe(&i2c->dev, PTR_ERR(aw->enable),
+				     "failed to get enable gpio\n");
+
+	/*
+	 * Check the chip ID, but never fail the probe: this component is an
+	 * auxiliary device of the sound card, so failing here would keep the
+	 * whole card (and the headphones) from ever registering.
+	 */
+	usleep_range(2000, 3000);
+	ret = regmap_read(aw->regmap, AW87339_REG_CHIPID, &id);
+	if (ret)
+		dev_warn(&i2c->dev, "chip ID read failed: %d\n", ret);
+	else if (id != AW87339_CHIPID)
+		dev_warn(&i2c->dev, "unexpected chip ID 0x%02x\n", id);
+	else
+		dev_info(&i2c->dev, "AW87339 found\n");
+
+	regmap_write(aw->regmap, AW87339_REG_SYSCTRL, AW87339_PWR_DOWN);
+	gpiod_set_value_cansleep(aw->enable, 0);
+
+	return devm_snd_soc_register_component(&i2c->dev, &aw87339_component,
+					       NULL, 0);
+}
+
+static const struct i2c_device_id aw87339_i2c_id[] = {
+	{ "aw87339" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw87339_i2c_id);
+
+static const struct of_device_id aw87339_of_match[] = {
+	{ .compatible = "awinic,aw87339" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw87339_of_match);
+
+static struct i2c_driver aw87339_i2c_driver = {
+	.driver = {
+		.name = "aw87339",
+		.of_match_table = aw87339_of_match,
+	},
+	.probe = aw87339_i2c_probe,
+	.id_table = aw87339_i2c_id,
+};
+module_i2c_driver(aw87339_i2c_driver);
+
+MODULE_DESCRIPTION("Awinic AW87339 speaker amplifier driver");
+MODULE_LICENSE("GPL");
