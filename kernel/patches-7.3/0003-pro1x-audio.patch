+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/awinic,aw87339.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW87339 class-K speaker amplifier
+
+maintainers:
+  - Nyymi <accee22@protonmail.com>
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: awinic,aw87339
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    maxItems: 1
+    description: Chip enable line, high powers the amplifier.
+
+  sound-name-prefix: true
+
+required:
+  - compatible
+  - reg
+  - enable-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@59 {
+            compatible = "awinic,aw87339";
+            reg = <0x59>;
+            enable-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+            sound-name-prefix = "Spk0";
+        };
+    };
