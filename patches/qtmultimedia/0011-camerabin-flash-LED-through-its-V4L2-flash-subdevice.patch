index 2483f1ca..d265655f 100644
--- a/src/plugins/gstreamer/camerabin/camerabinflash.h
+++ b/src/plugins/gstreamer/camerabin/camerabinflash.h
@@ -70,7 +70,10 @@ private:
     bool rearCamera() const;
 
     CameraBinSession *m_session;
+    bool setLedV4l2(const QString &led, bool on);
+
     QStringList m_leds;
+    QMap<QString, int> m_ledFds;     // open V4L2 flash subdevices while their LED is on
     QByteArray m_ledBrightness;
     QCameraExposure::FlashModes m_ledMode;
     bool m_ledOn;
