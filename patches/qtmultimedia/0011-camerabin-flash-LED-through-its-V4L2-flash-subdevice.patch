@@ -80,11 +86,60 @@ bool CameraBinFlash::rearCamera() const
             != QCamera::FrontFace;
 }
 
+/*
+ * The LED's V4L2 flash subdevice (CONFIG_V4L2_FLASH_LED_CLASS): the sandboxed camera
+ * app cannot write /sys, but it can open /dev/v4l-subdev*. Torch mode at the highest
+ * torch intensity; the subdevice stays open while the LED is on.
+ */
+bool CameraBinFlash::setLedV4l2(const QString &led, bool on)
+{
+    if (!on) {
+        if (!m_ledFds.contains(led))
+            return false;
+        const int fd = m_ledFds.take(led);
+        struct v4l2_control ctrl = { V4L2_CID_FLASH_LED_MODE, V4L2_FLASH_LED_MODE_NONE };
+        ioctl(fd, VIDIOC_S_CTRL, &ctrl);
+        ::close(fd);
+        return true;
+    }
+
+    const QDir dir(QStringLiteral("/sys/class/video4linux"));
+    for (const QString &node : dir.entryList(QStringList(QStringLiteral("v4l-subdev*")))) {
+        QFile name(dir.filePath(node + QStringLiteral("/name")));
+        if (!name.open(QIODevice::ReadOnly) || QString::fromLatin1(name.readAll()).trimmed() != led)
+            continue;
+        const int fd = ::open(QFile::encodeName(QStringLiteral("/dev/") + node).constData(),
+                              O_RDWR | O_CLOEXEC);
+        if (fd < 0) {
+            qWarning("camerabin: cannot open %s for flash LED %s", qPrintable(node), qPrintable(led));
+            return false;
+        }
+        struct v4l2_queryctrl q;
+        memset(&q, 0, sizeof(q));
+        q.id = V4L2_CID_FLASH_TORCH_INTENSITY;
+        if (ioctl(fd, VIDIOC_QUERYCTRL, &q) == 0) {
+            struct v4l2_control intensity = { V4L2_CID_FLASH_TORCH_INTENSITY, q.maximum };
+            ioctl(fd, VIDIOC_S_CTRL, &intensity);
+        }
+        struct v4l2_control ctrl = { V4L2_CID_FLASH_LED_MODE, V4L2_FLASH_LED_MODE_TORCH };
+        if (ioctl(fd, VIDIOC_S_CTRL, &ctrl) < 0) {
+            qWarning("camerabin: flash LED %s: torch mode failed", qPrintable(led));
+            ::close(fd);
+            return false;
+        }
+        m_ledFds.insert(led, fd);
+        return true;
+    }
+    return false;
+}
+
 void CameraBinFlash::setLed(bool on)
 {
     if (on == m_ledOn)
         return;
     for (const QString &led : m_leds) {
+        if (setLedV4l2(led, on))
+            continue;
         QFile f(QStringLiteral("/sys/class/leds/%1/brightness").arg(led));
         if (!f.open(QIODevice::WriteOnly) || f.write(on ? m_ledBrightness : QByteArray("0")) < 0)
             qWarning("camerabin: cannot switch flash LED %s: %s", qPrintable(led),
