+void CameraBinFocus::setLibcameraWindow(const QRectF &rectangle)
+{
+    GstElement *source = libcameraSource();
+    if (!source || m_cameraStatus != QCamera::ActiveStatus)
+        return;
+
+    GValue windows = G_VALUE_INIT;
+    g_value_init(&windows, GST_TYPE_ARRAY);
+
+    // AfWindows are in pixel array coordinates. The software ISP's input frame shows
+    // the active area (binned), and the stream is a centred crop of that frame, so the
+    // frame is the smallest rectangle of the active area's shape around the viewfinder.
+    const QRect area = libcameraActiveArea(m_session->device());
+    const QSize view = m_viewfinderResolution;
+    if (!rectangle.isEmpty() && !area.isEmpty() && !view.isEmpty()) {
+        const qreal frameWidth = qMax<qreal>(view.width(),
+                                             qreal(view.height()) * area.width() / area.height());
+        const qreal frameHeight = frameWidth * area.height() / area.width();
+        const qreal scale = area.width() / frameWidth;
+        const int window[4] = {
+            int(area.x() + ((frameWidth - view.width()) / 2 + rectangle.x() * view.width()) * scale),
+            int(area.y() + ((frameHeight - view.height()) / 2 + rectangle.y() * view.height()) * scale),
+            int(rectangle.width() * view.width() * scale) + (m_windowToggle ? 8 : 0),
+            int(rectangle.height() * view.height() * scale)
+        };
+        GValue rect = G_VALUE_INIT;
+        g_value_init(&rect, GST_TYPE_ARRAY);
+        for (int value : window) {
+            GValue v = G_VALUE_INIT;
+            g_value_init(&v, G_TYPE_INT);
+            g_value_set_int(&v, value);
+            gst_value_array_append_and_take_value(&rect, &v);
+        }
+        gst_value_array_append_and_take_value(&windows, &rect);
+    }
+
+    g_object_set_property(G_OBJECT(source), "af-windows", &windows);
+    g_value_unset(&windows);
+}
+
+void CameraBinFocus::pollLibcameraFocus()
+{
+    GstElement *source = libcameraSource();
+    gint state = 0;     // AfStateIdle, Scanning, Focused, Failed
+    if (source)
+        g_object_get(G_OBJECT(source), "af-state", &state, NULL);
+
+    // the last report can predate the restart: wait to see the new scan first
+    if (state == 1)
+        m_sawScanning = true;
+    ++m_lockPolls;
+
+    QCamera::LockStatus status = QCamera::Searching;
+    if (!source || (m_sawScanning && state == 2) || (m_lockPolls >= 5 && state == 0))
+        status = QCamera::Locked;
+    else if (m_lockPolls >= 80)     // 8 s
+        status = QCamera::Unlocked;
+    else if (!m_sawScanning && m_lockPolls >= 10 && state == 2)
+        status = QCamera::Locked;   // the scan finished between two polls
+
+    if (status != QCamera::Searching) {
+        m_lockTimer.stop();
+        setFocusAssist(false);
+        _q_setFocusStatus(status, status == QCamera::Locked ? QCamera::LockAcquired
+                                                             : QCamera::LockFailed);
+    }
+}
+
+void CameraBinFocus::setFocusAssist(bool on)
+{
+    CameraBinFlash *flash = m_session->cameraFlashControl();
+    if (!flash || !flash->ledFlash())
+        return;
+    if (on && flash->firesOnCapture()) {
+        flash->setLed(true);
+        m_assist = true;
+    } else if (!on && m_assist) {
+        // the capture switches the LED on again for its flash
+        if (!flash->flashMode().testFlag(QCameraExposure::FlashTorch))
+            flash->setLed(false);
+        m_assist = false;
+    }
+}
