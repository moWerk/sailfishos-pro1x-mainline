+// Pixel array active area of a libcamera camera, from the device provider's properties
+// (an array of rectangles flattened to x, y, width, height, ...); looked up once per camera
+static QRect libcameraActiveArea(const QString &device)
+{
+    static QHash<QString, QRect> areas;
+    if (areas.contains(device))
+        return areas.value(device);
+
+    QRect area;
+    if (GstDeviceProvider *provider = gst_device_provider_factory_get_by_name("libcameraprovider")) {
+        GList *list = gst_device_provider_get_devices(provider);
+        for (GList *l = list; l; l = l->next) {
+            GstDevice *gstDevice = GST_DEVICE(l->data);
+            gchar *name = gst_device_get_display_name(gstDevice);
+            GstStructure *props = gst_device_get_properties(gstDevice);
+            const GValue *value = props
+                    ? gst_structure_get_value(props, "api.libcamera.PixelArrayActiveAreas") : 0;
+            if (device == QString::fromUtf8(name) && value && GST_VALUE_HOLDS_ARRAY(value)
+                    && gst_value_array_get_size(value) >= 4) {
+                int a[4];
+                for (int k = 0; k < 4; ++k)
+                    a[k] = g_value_get_int(gst_value_array_get_value(value, k));
+                area = QRect(a[0], a[1], a[2], a[3]);
+            }
+            if (props)
+                gst_structure_free(props);
+            g_free(name);
+        }
+        g_list_free_full(list, reinterpret_cast<GDestroyNotify>(gst_object_unref));
+        gst_object_unref(provider);
+    }
+    areas.insert(device, area);
+    return area;
+}
