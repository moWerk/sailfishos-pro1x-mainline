+void CameraBinExposure::setLibcameraValue(ExposureParameter parameter, const QVariant &value)
+{
+    GstElement *source = libcameraSource();
+    if (!source)
+        return;     // applied when the camera becomes active
+
+    if (parameter == QCameraExposureControl::ISO) {
+        const int iso = value.toInt();
+        if (iso > 0)
+            g_object_set(G_OBJECT(source), "analogue-gain-mode", 1 /* manual */,
+                         "analogue-gain", gfloat(iso / 100.0), NULL);
+        else
+            g_object_set(G_OBJECT(source), "analogue-gain-mode", 0 /* auto */, NULL);
+    } else if (parameter == QCameraExposureControl::ExposureCompensation) {
+        g_object_set(G_OBJECT(source), "exposure-value", gfloat(value.toReal()), NULL);
+    }
+}
+
+void CameraBinExposure::applyLibcameraValues(QCamera::Status status)
+{
+    if (status != QCamera::ActiveStatus)
+        return;
+    for (auto it = m_requestedValues.constBegin(); it != m_requestedValues.constEnd(); ++it)
+        setLibcameraValue(it.key(), it.value());
+}
