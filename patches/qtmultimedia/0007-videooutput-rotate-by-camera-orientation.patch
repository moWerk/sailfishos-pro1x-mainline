diff --git a/src/qtmultimediaquicktools/qdeclarativevideooutput.cpp b/src/qtmultimediaquicktools/qdeclarativevideooutput.cpp
index cae6cf00..503b6eb0 100644
--- a/src/qtmultimediaquicktools/qdeclarativevideooutput.cpp
+++ b/src/qtmultimediaquicktools/qdeclarativevideooutput.cpp
@@ -127,6 +127,7 @@ QDeclarativeVideoOutput::QDeclarativeVideoOutput(QQuickItem *parent) :
     m_fillMode(PreserveAspectFit),
     m_geometryDirty(true),
     m_orientation(0),
+    m_sourceOrientation(0),
     m_autoOrientation(false),
     m_screenOrientationHandler(0)
 {
@@ -317,10 +318,41 @@ void QDeclarativeVideoOutput::_q_updateCameraInfo()
                 if (m_autoOrientation)
                     _q_screenOrientationChanged(m_screenOrientationHandler->currentOrientation());
             }
+
+            // Without autoOrientation the frames are drawn as the sensor delivers them. The
+            // hybris video texture backend rotates them by the image-orientation tag of the
+            // viewfinder stream (droidcamsrc); with Qt's own renderer (libcamerasrc, which
+            // sends no such tag) rotate by the camera's mounting orientation instead.
+            int sourceOrientation = 0;
+#ifndef QT_NO_DYNAMIC_CAST
+            if (!m_autoOrientation && !info.isNull()
+                    && dynamic_cast<QDeclarativeVideoRendererBackend *>(m_backend.data()))
+                sourceOrientation = info.orientation();
+#endif
+            setSourceOrientation(sourceOrientation);
         }
     } else {
         m_cameraInfo = QCameraInfo();
+        setSourceOrientation(0);
+    }
+}
+
+void QDeclarativeVideoOutput::setSourceOrientation(int orientation)
+{
+    if (m_sourceOrientation == orientation)
+        return;
+
+    const bool oldAspect = qIsDefaultAspect(renderOrientation());
+    m_sourceOrientation = orientation;
+    m_geometryDirty = true;
+
+    if (oldAspect != qIsDefaultAspect(renderOrientation())) {
+        m_nativeSize.transpose();
+        setImplicitWidth(m_nativeSize.width());
+        setImplicitHeight(m_nativeSize.height());
     }
+
+    update();
 }
 
