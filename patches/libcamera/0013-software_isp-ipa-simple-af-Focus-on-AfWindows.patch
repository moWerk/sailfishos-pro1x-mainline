+/**
+ * \brief Start a new scan from the near end
+ * \param[in] state The autofocus state
+ *
+ * Used when the focus area changes, for instance on a tap to focus. Unlike
+ * the internal reset after a scene change it does not wait for the ignore
+ * counter, the new scan begins after the configured number of ignored frames.
+ */
+void AfAlgorithm::restart(af::ActiveState &state)
+{
+	state.maxVariance = 0;
+	state.focus = 0;
+	focus_ = 0;
+	state.stable = false;
+	ignoreCounter_ = params_.ignoreFrames;
+	previousVariance_ = 0.0;
+	coarseCompleted_ = false;
+	fineCompleted_ = false;
+	maxStep_ = initMaxStep_;
+}
+
