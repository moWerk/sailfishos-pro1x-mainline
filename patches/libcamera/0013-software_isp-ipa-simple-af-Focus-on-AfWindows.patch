@@ -296,6 +299,15 @@ int SoftwareIsp::configure(const StreamConfiguration &inputCfg,
 	if (ret < 0)
 		return ret;
 
+	IPACameraSensorInfo info{};
+	if (sensor_ && !sensor_->sensorInfo(&info)) {
+		afCrop_ = info.analogCrop;
+		afFrame_ = inputCfg.size;
+	} else {
+		afCrop_ = Rectangle();
+		afFrame_ = Size();
+	}
+
 	LOG(SoftwareIsp, Info)
 		<< "Input " << inputCfg.size
 		<< "-" << BayerFormat::fromPixelFormat(inputCfg.pixelFormat)
@@ -331,6 +343,28 @@ int SoftwareIsp::exportBuffers(const Stream *stream, unsigned int count,
  */
 void SoftwareIsp::queueRequest(const uint32_t frame, const ControlList &controls)
 {
+	/*
+	 * AfWindows are in pixel array coordinates; the autofocus sharpness is
+	 * computed on the input frame, which shows the sensor's analogue crop
+	 * (scaled by binning). The first window is used; none restores the default.
+	 */
+	const auto &afWindows = controls.get(controls::AfWindows);
+	if (afWindows && debayer_ && !afCrop_.isNull() && !afFrame_.isNull()) {
+		Rectangle area;
+		if (!afWindows->empty()) {
+			const Rectangle &w = (*afWindows)[0];
+			const double sx = static_cast<double>(afFrame_.width) / afCrop_.width;
+			const double sy = static_cast<double>(afFrame_.height) / afCrop_.height;
+			area = Rectangle(static_cast<int>((w.x - afCrop_.x) * sx),
+					 static_cast<int>((w.y - afCrop_.y) * sy),
+					 static_cast<unsigned int>(w.width * sx),
+					 static_cast<unsigned int>(w.height * sy));
+			if (area.x < 0 || area.y < 0)
+				area = Rectangle();
+		}
+		debayer_->setSharpnessArea(area);
+	}
+
 	ipa_->queueRequest(frame, controls);
 }
 
diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 3a19e983..1a10dc80 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -417,6 +417,14 @@ void SwStatsCpu::startFrame(uint32_t frame)
 	if (window_.width == 0)
 		LOG(SwStatsCpu, Error) << "Calling startFrame() without setWindow()";
 
+	{
+		std::lock_guard<std::mutex> lock(areaLock_);
+		if (pendingArea_) {
+			applySharpnessArea(*pendingArea_);
+			pendingArea_.reset();
+		}
+	}
+
 	for (auto &s : stats_) {
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		s.variance = 0.0;
@@ -622,6 +630,54 @@ void SwStatsCpu::setWindow(const Rectangle &window)
 	sharpnessWindow_.y = (window_.y + window_.height / 3) & ~1;
 	sharpnessWindow_.width = (window_.width / 3) & ~3;
 	sharpnessWindow_.height = (window_.height / 3) & ~1;
+	defaultSharpnessWindow_ = sharpnessWindow_;
+}
+
+/**
+ * \brief Set the area used for the autofocus sharpness
+ * \param[in] area The area in frame coordinates, empty for the default (the
+ * central third of the statistics window)
+ *
+ * May be called from any thread; the area is taken over at the start of the
+ * next frame for which statistics are gathered, clipped to the statistics
+ * window and aligned like the default.
+ */
+void SwStatsCpu::setSharpnessArea(const Rectangle &area)
+{
+	std::lock_guard<std::mutex> lock(areaLock_);
+	pendingArea_ = area;
+}
+
+void SwStatsCpu::applySharpnessArea(const Rectangle &area)
+{
+	static constexpr unsigned int kMinWidth = 64;
+	static constexpr unsigned int kMinHeight = 32;
+
+	if (area.isNull() || window_.width == 0) {
+		sharpnessWindow_ = defaultSharpnessWindow_;
+		return;
+	}
+
+	/* Grow small areas around their centre, then clip to the window */
+	Rectangle r = area;
+	if (r.width < kMinWidth) {
+		r.x -= (kMinWidth - r.width) / 2;
+		r.width = kMinWidth;
+	}
+	if (r.height < kMinHeight) {
+		r.y -= (kMinHeight - r.height) / 2;
+		r.height = kMinHeight;
+	}
+	r = r.boundedTo(window_);
+	if (r.width < kMinWidth || r.height < kMinHeight) {
+		sharpnessWindow_ = defaultSharpnessWindow_;
+		return;
+	}
+
+	sharpnessWindow_.x = r.x & ~3;
+	sharpnessWindow_.y = r.y & ~1;
+	sharpnessWindow_.width = r.width & ~3;
+	sharpnessWindow_.height = r.height & ~1;
 }
 
 void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
