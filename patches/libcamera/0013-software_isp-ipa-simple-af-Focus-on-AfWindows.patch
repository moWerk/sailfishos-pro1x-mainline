diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index 45d38b5d..8a708384 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -33,6 +33,17 @@ int Af::init(IPAContext &context, const ValueNode &tuningData)
 	/* Informs that lens controls can get focus data */
 	context.afEnabled = true;
 
+	/*
+	 * The scan runs continuously on the sharpness area; AfWindows moves that
+	 * area (mapped to the frame by the software ISP) and restarts the scan.
+	 */
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+	context.ctrlMap[&controls::AfMetering] =
+		ControlInfo(controls::AfMeteringValues, controls::AfMeteringAuto);
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle{}, Rectangle(0, 0, 65535, 65535), Rectangle{});
+
 	return 0;
 }
 
@@ -43,11 +54,29 @@ int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
 	return 0;
 }
 
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	const auto &windows = controls.get(controls::AfWindows);
+	if (!windows)
+		return;
+
+	const Rectangle window = windows->empty() ? Rectangle() : (*windows)[0];
+	if (window == window_)
+		return;
+
+	window_ = window;
+	LOG(IPASoftAf, Debug) << "Focus window " << window_ << ", rescanning";
+	afAlgo_.restart(context.activeState.af);
+}
+
 void Af::process(IPAContext &context,
 		 [[maybe_unused]] const uint32_t frame,
 		 [[maybe_unused]] IPAFrameContext &frameContext,
 		 const SwIspStats *stats,
-		 [[maybe_unused]] ControlList &metadata)
+		 ControlList &metadata)
 {
 	/* The stats are computed every few frames only */
 	if (!stats->valid || !stats->varianceSamples)
@@ -56,6 +85,10 @@ void Af::process(IPAContext &context,
 	const double variance = stats->variance;
 	LOG(IPASoftAf, Debug) << "Focus stats: " << variance;
 	afAlgo_.process(context.activeState.af, variance);
+
+	metadata.set(controls::AfState, context.activeState.af.stable
+					? controls::AfStateFocused
+					: controls::AfStateScanning);
 }
 
