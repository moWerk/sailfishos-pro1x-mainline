diff --color -ruN '--exclude=.git' sl-orig/stepsource.h /mnt/storage/sailfish/pro1x-mainline/port/packages/sensorlogd/upstream/stepsource.h
--- a/stepsource.h	1970-01-01 01:00:00.000000000 +0100
