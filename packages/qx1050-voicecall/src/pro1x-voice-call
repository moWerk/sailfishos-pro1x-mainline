#!/usr/bin/env bash
# Voice call session, started and stopped by the "Voice Call" UCM verb.
# SailfishOS variant of fxtec-pro1x-nixos device/audio/pro1x-voice-call: calls come from ofono.
#   start   start the session in the background
#   stop    stop it
#   run     the session itself (foreground)
#
pidfile="${XDG_RUNTIME_DIR:-/tmp}/pro1x-voice-call.pid"

case "${1:-run}" in
start)
    setsid pro1x-voice-call run >"${XDG_RUNTIME_DIR:-/tmp}/pro1x-voice-call.log" 2>&1 </dev/null &  # busybox setsid has no -f
  exit 0
  ;;
stop)
    [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null
  exit 0
  ;;
run) ;;
*)
  echo "usage: $0 start|stop|run" >&2
  exit 1
  ;;
esac

echo $$ >"$pidfile"
exec > >(while IFS= read -r l; do echo "$(cut -d' ' -f1 /proc/uptime) $l"; done) 2>&1
kp=""
cur=""
vp=""
sig=""
pick() { pactl list short "$1" | awk -v pat="$2" '$2 ~ pat && $2 !~ /monitor/ { print $2; exit }'; }

start_keepers() {
  sink=$(pick sinks 'Voice_Call')
  src=$(pick sources 'Voice_Call')
  cur="$sink $src"
  vol_now="" # a new sink comes with the UCM device gains: apply the call volume again
  [ -n "$sink" ] || return 1
  echo "keep-alive on $sink / $src"
  # SailfishOS has no paplay/parec (pulseaudio-utils would conflict with the port's pulseaudio)
  gst-launch-1.0 -q audiotestsrc wave=silence ! audio/x-raw,rate=48000,channels=2 ! pulsesink device="$sink" stream-properties="props,pro1x.voice=keepalive" >/dev/null 2>&1 &
  kp="$!"
  if [ -n "$src" ]; then
    gst-launch-1.0 -q pulsesrc device="$src" stream-properties="props,pro1x.voice=keepalive" ! audio/x-raw,rate=48000,channels=1 ! fakesink >/dev/null 2>&1 &
    kp="$kp $!"
  fi
}

stop_keepers() {
  [ -z "$kp" ] || kill $kp 2>/dev/null
  kp=""
}

# The first start of the codec DMA back ends after the switch to this verb stalls: the
# playback pointer (hw:0,0) stays at 0, and the capture side runs but delivers only
# zeros. It happens again on every new sink (earpiece/speaker switch). A suspend and
# resume of the sink and the source starts them again; both are restarted at once,
# since the capture stall does not show in its pointer. Root cause unknown (2026-10-29).
hw_ptr() { awk '/hw_ptr/ { print $3 }' /proc/asound/card0/pcm0p/sub0/status 2>/dev/null; }
kick_if_stalled() {
  local a b
  # both stall every time so far: restart both at once, then check the playback side
  [ -z "$src" ] || pactl suspend-source "$src" 1
  pactl suspend-sink "$sink" 1
  [ -z "$src" ] || pactl suspend-source "$src" 0
  pactl suspend-sink "$sink" 0
  echo "restarted $sink / $src"
  for try in 1 2 3; do
    a=$(hw_ptr); sleep 0.3; b=$(hw_ptr)
    [ -n "$a" ] && [ "$a" != "$b" ] && return 0
    echo "playback stalled (hw_ptr $a), restarting $sink"
    pactl suspend-sink "$sink" 1; sleep 0.2; pactl suspend-sink "$sink" 0; sleep 0.5
  done
  echo "playback still stalled"
}

# Call audio runs in the DSP and never passes the PulseAudio sink, so its volume does
# nothing. The codec's RX digital gain does: follow the sink volume times the call
# volume (the volume keys move module-meego-mainvolume's virtual stream) there. 68 (-16 dB) at 100 % is loud but bearable at the ear; the
# earpiece output gains (EAR_PA, HPHL) made no audible difference.
CALL_GAIN_MAX=68
vol_now=""
si_now=""
log_input_volumes() { # which volume the keys move during a call is not known yet: log
  local s
  s=$(pactl list sink-inputs | awk '/^Sink Input #/ { id = $3 } /^[ \t]*Volume:/ { printf "%s=%s ", id, $5 }')
  [ "$s" = "$si_now" ] || echo "sink inputs: $s"
  si_now=$s
}
follow_volume() {
  local sv iv v gain
  sv=$(pactl get-sink-volume "$sink" 2>/dev/null | awk 'NR == 1 { gsub(/%/, "", $5); print $5 }')
  [ -n "$sv" ] || return
  # the volume keys move module-meego-mainvolume's virtual call stream, not the sink
  iv=$(pactl list sink-inputs | awk '
    /^Sink Input #/ { mv = 0 }
    /Driver: module-meego-mainvolume/ { mv = 1 }
    mv && /^[ \t]*Volume:/ { gsub(/%/, "", $5); print $5; exit }')
  v=$(awk -v a="$sv" -v b="${iv:-100}" 'BEGIN { printf "%d", a * b / 100 }')
  [ "$v" = "$vol_now" ] && return
  vol_now=$v
  gain=$(awk -v p="$v" -v m="$CALL_GAIN_MAX" 'BEGIN {
    g = (p > 0) ? m + 20 * log(p / 100) / log(10) : 0; if (g < 24) g = 24; if (g > m) g = m
    printf "%d", g + 0.5 }')
  amixer -q -c0 cset name='RX_RX0 Digital Volume' "$gain"
  amixer -q -c0 cset name='RX_RX1 Digital Volume' "$gain"
  echo "call volume $v % -> RX digital $gain"
}

# Route the DSP voice session to the codec DMA ends while it runs. It does not cause
# the back end stall, but while it is on, the session keeps the stalled back ends from
# restarting.
# Bluetooth headset in the call: the DSP voice session goes to the AFE real-time proxy ports
# (kernel patches 0076/0077) instead of the codec, and two PulseAudio loopbacks bridge them to
# the headset (RTProxy card <-> bluez handsfree sink/source). A headset counts when a bluez
# sink is in the handsfree profile, or by hand with /run/pro1x-voice-bt or
# $XDG_RUNTIME_DIR/pro1x-voice-bt. Decided when the session starts; a change restarts it.
bt=0
bt_detect() {
  [ -e /run/pro1x-voice-bt ] || [ -e "${XDG_RUNTIME_DIR:-/tmp}/pro1x-voice-bt" ] && { echo 1; return; }
  pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_sink\..*handsfree_head_unit$/ { f = 1 } END { print f ? 1 : 0 }'
}

bt_mods=""
start_bridge() {
  local hs_sink hs_src m
  hs_sink=$(pactl list short sinks | awk '$2 ~ /^bluez_sink\..*handsfree_head_unit$/ { print $2; exit }')
  hs_src=$(pactl list short sources | awk '$2 ~ /^bluez_source\..*handsfree_head_unit$/ { print $2; exit }')
  if [ -z "$hs_sink" ] || [ -z "$hs_src" ]; then
    echo "bluetooth: no handsfree sink/source, no bridge"
    return 1
  fi
  for m in "module-alsa-sink device=hw:RTProxy,0 sink_name=rtproxy_uplink rate=48000 channels=2 tsched=0 sink_properties=pro1x.voice=keepalive" \
           "module-alsa-source device=hw:RTProxy,1 source_name=rtproxy_downlink rate=48000 channels=2 tsched=0 source_properties=pro1x.voice=keepalive" \
           "module-loopback source=$hs_src sink=rtproxy_uplink latency_msec=60 sink_input_properties=pro1x.voice=keepalive source_output_properties=pro1x.voice=keepalive" \
           "module-loopback source=rtproxy_downlink sink=$hs_sink latency_msec=60 sink_input_properties=pro1x.voice=keepalive source_output_properties=pro1x.voice=keepalive"; do
    # shellcheck disable=SC2086
    bt_mods="$(pactl load-module $m) $bt_mods" || echo "bluetooth: load failed: $m"
  done
  echo "bluetooth bridge up: $hs_src -> RTProxy uplink, RTProxy downlink -> $hs_sink (modules $bt_mods)"
}

stop_bridge() {
  local m
  for m in $bt_mods; do pactl unload-module "$m" 2>/dev/null; done
  [ -z "$bt_mods" ] || echo "bluetooth bridge down"
  bt_mods=""
}

voice_route() {
  local tx=$1 rx=$1 btrx=0 bttx=0
  [ "$1" = 1 ] && [ "$muted" = yes ] && tx=0 # in-call mute, see follow_mute
  if [ "$1" = 1 ] && [ "$bt" = 1 ]; then
    btrx=1; bttx=$tx; rx=0; tx=0
  fi
  amixer -q -c0 cset name='RX_CODEC_DMA_RX_0 Voice Mixer VoiceMMode1' "$rx"
  amixer -q -c0 cset name='VoiceMMode1 Capture Mixer VA_CODEC_DMA_TX_0' "$tx"
  amixer -q -c0 cset name='RT_PROXY_RX_1 Voice Mixer VoiceMMode1' "$btrx" 2>/dev/null
  amixer -q -c0 cset name='VoiceMMode1 Capture Mixer RT_PROXY_TX_1' "$bttx" 2>/dev/null
}

# In-call mute. Untested; mirrors the Guix port's follow_mute (fxtec-pro1x-guix 8545724), whose
# own status is "no effect yet". The call microphone goes codec -> DSP -> modem and never passes
# PulseAudio, so the mute voicecall-manager asks ohmd for (org.maemo.Playback.Manager RequestMute)
# cannot silence it. Follow voicecall-manager's isMicrophoneMuted (session bus) with the
# codec-to-DSP capture route instead. Whether switching that mixer mid-call upsets the voice
# session (see the back end stalls above) is not known.
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dbus/user_bus_socket}"
export DBUS_SESSION_BUS_ADDRESS
muted=no   # wanted state, also used by voice_route
mute_now="" # last state applied
mic_muted() {
  dbus-send --session --print-reply --dest=org.nemomobile.voicecall / org.freedesktop.DBus.Properties.Get \
    string:org.nemomobile.voicecall.VoiceCallManager string:isMicrophoneMuted 2>/dev/null |
    awk '/boolean/ { print ($3 == "true") ? "yes" : "no"; exit }'
}
follow_mute() {
  local m
  m=$(mic_muted)
  if [ -z "$m" ]; then
    [ "$mute_now" = unknown ] || echo "microphone mute not readable from voicecall-manager"
    mute_now=unknown
    return
  fi
  muted=$m
  [ "$m" = "$mute_now" ] && return
  mute_now=$m
  if [ "$m" = yes ]; then
    amixer -q -c0 cset name='VoiceMMode1 Capture Mixer VA_CODEC_DMA_TX_0' 0
  else
    amixer -q -c0 cset name='VoiceMMode1 Capture Mixer VA_CODEC_DMA_TX_0' 1
  fi
  echo "microphone muted: $m"
}

alive() {
  [ -n "$kp" ] || return 1
  for p in $kp; do kill -0 $p 2>/dev/null || return 1; done
  [ "$cur" = "$(pick sinks 'Voice_Call') $(pick sources 'Voice_Call')" ]
}

# The DSP voice session (pro1x-voicepcm) is tied to the call: it was found to work when
# it starts while a call exists and not when it was started beforehand (the same order
# as postmarketOS q6voiced). So it is started when ofono reports a connected call and
# stopped when the last one is over. A session opened while dialing stayed silent on
# SailfishOS, so dialing, alerting and incoming calls do not count yet. The codec
# keep-alive streams run for as long as the profile is active. PRO1X_VOICE_ALWAYS=1
# (or no dbus-send) starts it right away instead.
calls() { # object paths of the connected calls, on one line (SailfishOS: ofono)
  for m in $(dbus-send --system --print-reply --dest=org.ofono / org.ofono.Manager.GetModems 2>/dev/null |
             awk '/object path/ { gsub(/"/, "", $3); print $3 }'); do
    dbus-send --system --print-reply --dest=org.ofono "$m" org.ofono.VoiceCallManager.GetCalls 2>/dev/null |
      awk '/object path/ { gsub(/"/, "", $3); p = $3 }
           /string "State"/ { getline; gsub(/"/, "", $3)
             if ($3 ~ /^(active|held)$/) print p }'
  done | sort | tr '\n' ' '
}

start_pcm() {
  bt=$(bt_detect)
  voice_route 1
  pro1x-voicepcm &
  vp="$!"
  echo "voice session started$( [ "$bt" = 1 ] && echo ' (bluetooth headset)')"
  [ "$bt" = 1 ] && start_bridge
}

stop_pcm() {
  if [ -n "$vp" ]; then
    kill "$vp" 2>/dev/null
    wait "$vp" 2>/dev/null
    echo "voice session stopped"
  fi
  vp=""
  stop_bridge
  muted=no # voicecall-manager unmutes when the last call is gone
  mute_now=""
  voice_route 0
}

trap 'stop_keepers; stop_pcm; rm -f "$pidfile"; exit 0' TERM INT

always=0
if [ "${PRO1X_VOICE_ALWAYS:-0}" = 1 ] || ! command -v dbus-send >/dev/null 2>&1; then
  always=1
fi

while :; do
  if ! alive; then
    # a new sink (earpiece/speaker switch): the back ends start again and stall again.
    # During a call the voice session holds them open, so a restart of the sink alone
    # does not restart them: take the voice route off, restart, route again.
    voice_route 0
    stop_keepers
    if start_keepers; then
      sleep 0.3
      kick_if_stalled
      follow_volume
      [ -z "$vp" ] || voice_route 1
    fi
  fi

  if [ "$always" = 1 ]; then
    now=always
  else
    now=$(calls)
  fi

  added=0
  for c in $now; do
    case " $sig " in *" $c "*) ;; *) added=1 ;; esac
  done
  if [ -n "$vp" ] && [ "$added" = 0 ] && [ "$(bt_detect)" != "$bt" ]; then
    echo "bluetooth headset $( [ "$bt" = 1 ] && echo left || echo joined) the call"
    added=1 # restart the session on the new route
  fi
  if [ "$added" = 1 ]; then
    stop_pcm
    start_pcm # a new call: (re)start the session
  elif [ -z "$now" ] && [ -n "$vp" ]; then
    stop_pcm # the last call ended
  fi
  sig=$now

  [ -z "$vp" ] || follow_mute

  if [ -n "$sink" ]; then
    follow_volume
    [ -z "$vp" ] || log_input_volumes
  fi

  if [ -n "$vp" ] && ! kill -0 "$vp" 2>/dev/null; then
    wait "$vp" 2>/dev/null
    vp=""
    echo "voice session ended on its own"
    # no PCM to open (q6voice missing): nothing more to do in the always mode
    [ "$always" = 1 ] && exit 1
  fi
  sleep 0.5
done
