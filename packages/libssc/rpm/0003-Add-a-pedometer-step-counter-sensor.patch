+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+syntax = "proto2";
+
+/*
+ * Pedometer (step counter) specific data, as in Qualcomm's sns_pedometer.proto.
+ * The Sensor Core counts steps on the accelerometer by itself, also while the application
+ * processor sleeps, and reports the running total.
+ * @step_count: steps counted since the sensor was enabled.
+ * SSC_MSG_REPORT_PEDOMETER_CONFIG carries the current count when the sensor is enabled,
+ * SSC_MSG_REPORT_PEDOMETER_STEP every change.
+ */
+message SscPedometerResponse {
+	required uint32 step_count = 1;
+}
